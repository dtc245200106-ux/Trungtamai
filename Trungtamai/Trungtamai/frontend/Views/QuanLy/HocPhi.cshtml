@model List<Trungtamai.Models.HocVien>
@{
    Layout = null;
    var hoTen = ViewBag.HoTen ?? "Quản lý";
    string FormatVnd(decimal v) => v.ToString("N0") + " ₫";
    string FormatShort(decimal v)
    {
        if (v >= 1_000_000_000) return (v / 1_000_000_000m).ToString("0.##") + " tỷ";
        if (v >= 1_000_000) return (v / 1_000_000m).ToString("0.#") + "M";
        if (v >= 1_000) return (v / 1_000m).ToString("0.#") + "K";
        return v.ToString("N0");
    }
    var chartLabels = (ViewBag.ChartLabels as List<string>) ?? new List<string>();
    var chartDaDong = (ViewBag.ChartDaDong as List<decimal>) ?? new List<decimal>();
    var chartConNo = (ViewBag.ChartConNo as List<decimal>) ?? new List<decimal>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Học phí - LinguistAI</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#091426",
                        "primary-container": "#1e293b",
                        "on-primary": "#ffffff",
                        background: "#f7f9fb",
                        surface: "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e5",
                        "outline-variant": "#c5c6cd",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#45474c",
                        secondary: "#006a61",
                        error: "#ba1a1a"
                    },
                    fontFamily: { sans: ["Inter"] },
                    borderRadius: { lg: "0.5rem", xl: "0.75rem" }
                }
            }
        };
    </script>
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .sidebar-item { transition: all 0.2s ease; }
        .sidebar-item:hover { background: #e6e8ea; }
        .sidebar-item.active { background: #091426; color: white; }
        .modal-backdrop { background: rgba(9,20,38,0.45); }
    </style>
</head>
<body class="bg-background text-on-surface">
    <div class="min-h-screen flex">
        <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">
            <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">
                <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">
                    <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">school</span>
                </div>
                <div>
                    <div class="font-bold text-primary text-lg">LinguistAI</div>
                    <div class="text-xs text-on-surface-variant">Quản lý trung tâm</div>
                </div>
            </div>

            <nav class="flex-1 px-3 py-5 space-y-1">
                <a asp-controller="QuanLy" asp-action="Index" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">dashboard</span> Tổng quan
                </a>
                <a asp-controller="QuanLy" asp-action="HocVien" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">group</span> Học viên
                </a>
                <a asp-controller="QuanLy" asp-action="GiaoVien" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">person</span> Giáo viên
                </a>
                <a asp-controller="QuanLy" asp-action="KhoaHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">menu_book</span> Khóa học
                </a>
                <a asp-controller="QuanLy" asp-action="LopHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">groups</span> Lớp học
                </a>
                <a asp-controller="QuanLy" asp-action="LichHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">calendar_month</span> Lịch học
                </a>
                <a asp-controller="QuanLy" asp-action="HocPhi" class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
                    <span class="material-symbols-outlined">payments</span> Học phí
                </a>
                <a asp-controller="QuanLy" asp-action="KetQuaHocTap" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">assessment</span> Kết quả học tập
                </a>
                <a asp-controller="QuanLy" asp-action="ThongKe" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">bar_chart</span> Thống kê
                </a>
            </nav>

            <div class="border-t border-surface-variant p-4">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
                        @(hoTen.ToString().Substring(0, 1).ToUpper())
                    </div>
                    <div class="min-w-0">
                        <div class="font-medium text-sm truncate">@hoTen</div>
                        <div class="text-xs text-on-surface-variant">Quản lý</div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="ml-[250px] flex-1 min-h-screen">
            <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8 sticky top-0 z-10">
                <div>
                    <h1 class="text-2xl font-bold text-primary">Học phí</h1>
                    <p class="text-sm text-on-surface-variant mt-0.5">Theo dõi thanh toán, công nợ và doanh thu thực tế</p>
                </div>
                <div class="flex items-center gap-3">
                    <form asp-action="DongBoHocPhiTuKhoaHoc" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition"
                                title="Gán học phí = giá khóa học cho HV chưa có học phí">
                            <span class="material-symbols-outlined text-[20px]">sync</span>
                            Đồng bộ từ khóa học
                        </button>
                    </form>
                    <a asp-controller="Account" asp-action="Logout"
                       class="flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
                        <span class="material-symbols-outlined text-[20px]">logout</span>
                        Đăng xuất
                    </a>
                </div>
            </header>

            <div class="p-8">
                @if (TempData["Success"] != null)
                {
                    <div class="mb-5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">@TempData["Error"]</div>
                }

                <!-- KPI -->
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
                    <div class="bg-white rounded-xl border border-outline-variant p-5">
                        <div class="flex items-center justify-between">
                            <div class="text-sm text-on-surface-variant">Tổng phải thu</div>
                            <span class="material-symbols-outlined text-on-surface-variant">account_balance_wallet</span>
                        </div>
                        <div class="text-2xl font-semibold text-primary mt-2">@FormatShort((decimal)(ViewBag.TongPhaiDong ?? 0))</div>
                        <div class="text-xs text-on-surface-variant mt-1">@FormatVnd((decimal)(ViewBag.TongPhaiDong ?? 0))</div>
                    </div>
                    <div class="bg-white rounded-xl border border-outline-variant p-5">
                        <div class="flex items-center justify-between">
                            <div class="text-sm text-on-surface-variant">Đã thu (doanh thu)</div>
                            <span class="material-symbols-outlined text-emerald-600">payments</span>
                        </div>
                        <div class="text-2xl font-semibold text-emerald-700 mt-2">@FormatShort((decimal)(ViewBag.TongDaDong ?? 0))</div>
                        <div class="text-xs text-on-surface-variant mt-1">@FormatVnd((decimal)(ViewBag.TongDaDong ?? 0))</div>
                    </div>
                    <div class="bg-white rounded-xl border border-outline-variant p-5">
                        <div class="flex items-center justify-between">
                            <div class="text-sm text-on-surface-variant">Còn nợ</div>
                            <span class="material-symbols-outlined text-amber-600">money_off</span>
                        </div>
                        <div class="text-2xl font-semibold text-amber-700 mt-2">@FormatShort((decimal)(ViewBag.TongConNo ?? 0))</div>
                        <div class="text-xs text-on-surface-variant mt-1">@FormatVnd((decimal)(ViewBag.TongConNo ?? 0))</div>
                    </div>
                    <div class="bg-white rounded-xl border border-outline-variant p-5">
                        <div class="flex items-center justify-between">
                            <div class="text-sm text-on-surface-variant">Tỷ lệ thu</div>
                            <span class="material-symbols-outlined text-primary">percent</span>
                        </div>
                        <div class="text-2xl font-semibold text-primary mt-2">@(ViewBag.TyLeThu ?? 0)%</div>
                        <div class="mt-2 h-2 rounded-full bg-surface-container">
                            <div class="h-2 rounded-full bg-primary" style="width:@(Math.Min(100, (double)(ViewBag.TyLeThu ?? 0)))%"></div>
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
                    <div class="xl:col-span-2 bg-white rounded-xl border border-outline-variant p-5">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-primary">Doanh thu theo khóa học</h3>
                            <span class="text-xs text-on-surface-variant">Đã thu / Còn nợ</span>
                        </div>
                        <div class="h-64">
                            <canvas id="chartDoanhThu"></canvas>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl border border-outline-variant p-5">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-primary">Trạng thái thanh toán</h3>
                        </div>
                        <div class="h-56 flex items-center justify-center">
                            <canvas id="chartTrangThai"></canvas>
                        </div>
                        <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
                            <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Đã đóng: @(ViewBag.PieDaDong ?? 0)</div>
                            <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Chưa đủ: @(ViewBag.PieChuaDu ?? 0)</div>
                            <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-red-400"></span> Chưa đóng: @(ViewBag.PieChuaDong ?? 0)</div>
                            
                        </div>
                    </div>
                </div>

                <!-- Filter -->
                <div class="bg-white rounded-xl border border-outline-variant p-4 mb-5">
                    <form method="get" class="flex flex-wrap items-center gap-3">
                        <div class="relative flex-1 min-w-[200px]">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
                            <input type="text" name="q" value="@ViewBag.SearchQ" placeholder="Tìm theo tên, mã, khóa, lớp..."
                                   class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-outline-variant text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />
                        </div>
                        <select name="trangThai" class="rounded-lg border border-outline-variant px-3 py-2.5 text-sm">
                            @{
                                var opts = new[] { "Tất cả", "Đã đóng", "Chưa đủ", "Chưa đóng" };
                                var cur = (string)(ViewBag.FilterTrangThai ?? "Tất cả");
                            }
                            @foreach (var o in opts)
                            {
                                if (o == cur)
                                {
                                    <option value="@o" selected>@o</option>
                                }
                                else
                                {
                                    <option value="@o">@o</option>
                                }
                            }
                        </select>
                        <button type="submit" class="bg-primary text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-primary-container transition">
                            Lọc
                        </button>
                    </form>
                </div>

                <!-- Table -->
                <div class="bg-white rounded-xl border border-outline-variant overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm">
                            <thead class="bg-surface-container-low text-on-surface-variant">
                                <tr>
                                    <th class="px-5 py-3.5 font-medium">Mã HV</th>
                                    <th class="px-5 py-3.5 font-medium">Học viên</th>
                                    <th class="px-5 py-3.5 font-medium">Khóa học</th>
                                    <th class="px-5 py-3.5 font-medium">Lớp</th>
                                    <th class="px-5 py-3.5 font-medium text-right">Học phí</th>
                                    <th class="px-5 py-3.5 font-medium text-right">Đã đóng</th>
                                    <th class="px-5 py-3.5 font-medium text-right">Còn nợ</th>
                                    <th class="px-5 py-3.5 font-medium">Trạng thái</th>
                                    <th class="px-5 py-3.5 font-medium text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="px-5 py-10 text-center text-on-surface-variant">
                                        Chưa có dữ liệu học phí. Thêm học viên hoặc bấm "Đồng bộ từ khóa học".
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var hv in Model)
                                {
                                                                        var badgeClass = hv.TrangThaiHocPhi switch
                                    {
                                        "Đã đóng" => "bg-emerald-100 text-emerald-700",
                                        "Chưa đủ" => "bg-amber-100 text-amber-700",
                                        _ => "bg-red-100 text-red-700"
                                    };
                                    <tr class="border-t border-outline-variant hover:bg-surface-container-low">
                                        <td class="px-5 py-3.5 text-on-surface-variant">@hv.MaHocVien</td>
                                        <td class="px-5 py-3.5">
                                            <div class="font-medium text-on-surface">@hv.HoTen</div>
                                            <div class="text-xs text-on-surface-variant">@hv.SoDienThoai</div>
                                        </td>
                                        <td class="px-5 py-3.5">@hv.KhoaHoc</td>
                                        <td class="px-5 py-3.5">@hv.LopHoc</td>
                                        <td class="px-5 py-3.5 text-right font-medium">@FormatVnd(hv.SoTienPhaiDong)</td>
                                        <td class="px-5 py-3.5 text-right text-emerald-700">@FormatVnd(hv.SoTienDaDong)</td>
                                        <td class="px-5 py-3.5 text-right @(hv.ConNo > 0 ? "text-amber-700 font-medium" : "text-on-surface-variant")">@FormatVnd(hv.ConNo)</td>
                                        <td class="px-5 py-3.5">
                                            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium @badgeClass">@hv.TrangThaiHocPhi</span>
                                            @if (hv.NgayDongCuoi.HasValue)
                                            {
                                                <div class="text-[11px] text-on-surface-variant mt-0.5">@hv.NgayDongCuoi.Value.ToString("dd/MM/yyyy")</div>
                                            }
                                        </td>
                                                                                <td class="px-5 py-3.5">
                                            <div class="flex items-center justify-center gap-1">
                                                <button type="button"
                                                        onclick="moThanhToan(@hv.Id, '@hv.HoTen.Replace("'", "\\'")', @hv.ConNo.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                        class="p-1.5 rounded-lg hover:bg-emerald-50 text-emerald-700"
                                                        title="Ghi nhận thanh toán">
                                                    <span class="material-symbols-outlined text-[20px]">add_card</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal ghi nhận thanh toán -->
    <div id="modalThanhToan" class="hidden fixed inset-0 z-50 flex items-center justify-center modal-backdrop">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 overflow-hidden">
            <div class="px-6 py-4 border-b border-outline-variant flex items-center justify-between">
                <h3 class="font-semibold text-primary">Ghi nhận thanh toán</h3>
                <button type="button" onclick="dongModal('modalThanhToan')" class="p-1 rounded hover:bg-surface-container">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <form asp-action="GhiNhanThanhToan" method="post" class="p-6 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="tt_id" />
                <div>
                    <div class="text-sm text-on-surface-variant">Học viên</div>
                    <div class="font-medium" id="tt_ten"></div>
                </div>
                <div>
                    <div class="text-sm text-on-surface-variant mb-1">Còn nợ</div>
                    <div class="text-lg font-semibold text-amber-700" id="tt_conno"></div>
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface">Số tiền thanh toán (₫)</label>
                    <input type="number" name="soTien" id="tt_sotien" min="1000" step="1000" required
                           class="mt-1 w-full rounded-lg border border-outline-variant px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface">Ghi chú (tuỳ chọn)</label>
                    <input type="text" name="ghiChu" class="mt-1 w-full rounded-lg border border-outline-variant px-3 py-2.5 text-sm" placeholder="VD: Đợt 2, chuyển khoản..." />
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="dongModal('modalThanhToan')" class="px-4 py-2 rounded-lg border border-outline-variant text-sm">Huỷ</button>
                    <button type="submit" class="px-5 py-2 rounded-lg bg-primary text-white text-sm font-medium">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>

    

<script>
    function formatVnd(n) {
        return new Intl.NumberFormat('vi-VN').format(n) + ' ₫';
    }
    function moThanhToan(id, ten, conNo) {
        document.getElementById('tt_id').value = id;
        document.getElementById('tt_ten').textContent = ten;
        document.getElementById('tt_conno').textContent = formatVnd(conNo);
        document.getElementById('tt_sotien').value = conNo > 0 ? conNo : '';
        document.getElementById('modalThanhToan').classList.remove('hidden');
    }

    function dongModal(id) {
        document.getElementById(id).classList.add('hidden');
    }

    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels));
    const dataDaDong = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartDaDong));
    const dataConNo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartConNo));

    if (document.getElementById('chartDoanhThu')) {
        new Chart(document.getElementById('chartDoanhThu'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Đã thu', data: dataDaDong, backgroundColor: '#059669', borderRadius: 6 },
                    { label: 'Còn nợ', data: dataConNo, backgroundColor: '#f59e0b', borderRadius: 6 }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: {
                        callbacks: {
                            label: ctx => ctx.dataset.label + ': ' + new Intl.NumberFormat('vi-VN').format(ctx.raw) + ' ₫'
                        }
                    }
                },
                scales: {
                    x: { ticks: { maxRotation: 45, font: { size: 11 } } },
                    y: {
                        ticks: {
                            callback: v => {
                                if (v >= 1e9) return (v / 1e9) + ' tỷ';
                                if (v >= 1e6) return (v / 1e6) + 'M';
                                if (v >= 1e3) return (v / 1e3) + 'K';
                                return v;
                            }
                        }
                    }
                }
            }
        });
    }

    if (document.getElementById('chartTrangThai')) {
        new Chart(document.getElementById('chartTrangThai'), {
            type: 'doughnut',
            data: {
                labels: ['Đã đóng', 'Chưa đủ', 'Chưa đóng'],
                datasets: [{
                    data: [
                        @(ViewBag.PieDaDong ?? 0),
                        @(ViewBag.PieChuaDu ?? 0),
                        @(ViewBag.PieChuaDong ?? 0),
                        
                    ],
                    backgroundColor: ['#10b981', '#f59e0b', '#f87171', '#94a3b8'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                cutout: '62%'
            }
        });
    }
</script>
</body>
</html>