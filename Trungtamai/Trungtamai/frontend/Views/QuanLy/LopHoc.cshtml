@model List<Trungtamai.Models.LopHoc>

@{
    Layout = null;
    var hoTen = ViewBag.HoTen ?? "Quản lý";
    var tongLop = ViewBag.TongLop ?? 0;
    var dangHoc = ViewBag.DangHoc ?? 0;
    var sapKhaiGiang = ViewBag.SapKhaiGiang ?? 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lớp học - LinguistAI</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#091426",
                        "primary-container": "#1e293b",
                        "on-primary": "#ffffff",
                        background: "#f7f9fb",
                        surface: "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e5",
                        "outline-variant": "#c5c6cd",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#45474c",
                        secondary: "#006a61",
                        error: "#ba1a1a"
                    },
                    fontFamily: { sans: ["Inter"] },
                    borderRadius: { lg: "0.5rem", xl: "0.75rem" }
                }
            }
        };
    </script>
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .sidebar-item { transition: all 0.2s ease; }
        .sidebar-item:hover { background: #e6e8ea; }
        .sidebar-item.active { background: #091426; color: white; }
        .stat-card { transition: all 0.2s ease; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
    </style>
</head>
<body class="bg-background text-on-surface">
<div class="min-h-screen flex">

    <!-- SIDEBAR -->
    <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">
        <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">school</span>
            </div>
            <div>
                <div class="font-bold text-primary text-lg">LinguistAI</div>
                <div class="text-xs text-on-surface-variant">Quản lý trung tâm</div>
            </div>
        </div>
        <nav class="flex-1 px-3 py-5 space-y-1">
            <a asp-controller="QuanLy" asp-action="Index" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">dashboard</span> Tổng quan
            </a>
            <a asp-controller="QuanLy" asp-action="HocVien" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">group</span> Học viên
            </a>
            <a asp-controller="QuanLy" asp-action="GiaoVien" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">person</span> Giáo viên
            </a>
            <a asp-controller="QuanLy" asp-action="KhoaHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">menu_book</span> Khóa học
            </a>
            <a asp-controller="QuanLy" asp-action="LopHoc" class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
                <span class="material-symbols-outlined">groups</span> Lớp học
            </a>
            <a asp-controller="QuanLy" asp-action="LichHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">calendar_month</span> Lịch học
            </a>
            <a asp-controller="QuanLy" asp-action="HocPhi" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">payments</span> Học phí
            </a>
            <a asp-controller="QuanLy" asp-action="KetQuaHocTap" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">assessment</span> Kết quả học tập
            </a>
            <a asp-controller="QuanLy" asp-action="ThongKe" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">bar_chart</span> Thống kê
            </a>
        </nav>
        <div class="border-t border-surface-variant p-4">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
                    @(hoTen.ToString().Length > 0 ? hoTen.ToString().Substring(0, 1).ToUpper() : "Q")
                </div>
                <div class="min-w-0">
                    <div class="font-medium text-sm truncate">@hoTen</div>
                    <div class="text-xs text-on-surface-variant">Quản lý</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="ml-[250px] flex-1 min-h-screen">
        <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8 sticky top-0 z-10">
            <div>
                <h1 class="text-2xl font-bold text-primary">Quản lý Lớp học</h1>
                <p class="text-sm text-on-surface-variant mt-0.5">Danh sách lớp, học viên và giảng viên theo ca học</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" onclick="moModalThemLop()"
                        class="flex items-center gap-2 bg-primary text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:opacity-90 transition">
                    <span class="material-symbols-outlined text-[20px]">add</span>
                    Tạo lớp mới
                </button>
                <a asp-controller="Account" asp-action="Logout"
                   class="flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
                    <span class="material-symbols-outlined text-[20px]">logout</span>
                    Đăng xuất
                </a>
            </div>
        </header>

        <div class="p-8">
            @if (TempData["Success"] != null)
            {
                <div class="mb-6 flex items-center gap-3 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700">
                    <span class="material-symbols-outlined">check_circle</span>
                    <span>@TempData["Success"]</span>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mb-6 flex items-center gap-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700">
                    <span class="material-symbols-outlined">error</span>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <!-- STATS -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">groups</span>
                    </div>
                    <div class="mt-5">
                        <div class="text-sm text-on-surface-variant">Tổng lớp học</div>
                        <div class="text-3xl font-semibold text-primary mt-1">@tongLop</div>
                    </div>
                </div>
                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">play_circle</span>
                    </div>
                    <div class="mt-5">
                        <div class="text-sm text-on-surface-variant">Đang học</div>
                        <div class="text-3xl font-semibold text-primary mt-1">@dangHoc</div>
                    </div>
                </div>
                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">schedule</span>
                    </div>
                    <div class="mt-5">
                        <div class="text-sm text-on-surface-variant">Sắp khai giảng</div>
                        <div class="text-3xl font-semibold text-primary mt-1">@sapKhaiGiang</div>
                    </div>
                </div>
            </div>

            <!-- SEARCH + LỌC NGÔN NGỮ -->
<div class="bg-white rounded-xl border border-outline-variant p-5 mb-6">
    <div class="flex flex-col sm:flex-row gap-4">
        <!-- Ô tìm kiếm -->
        <div class="relative flex-1">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
            <input id="timKiemLop" type="text" placeholder="Tìm theo mã lớp, tên lớp, khóa học, giáo viên..."
                   class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-outline-variant bg-surface-container-low text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />
        </div>

        <!-- Dropdown lọc ngôn ngữ -->
        <div class="w-full sm:w-56">
            <select id="locNgonNguLop"
                    class="w-full rounded-lg border border-outline-variant bg-surface-container-low px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                <option value="">-- Tất cả ngôn ngữ --</option>
                <option value="Tiếng Anh">Tiếng Anh</option>
                <option value="Tiếng Trung">Tiếng Trung</option>
                <option value="Tiếng Nhật">Tiếng Nhật</option>
                <option value="Tiếng Hàn">Tiếng Hàn</option>
            </select>
        </div>
    </div>
</div>

            <!-- TABLE -->
            <div class="bg-white rounded-xl border border-outline-variant overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm">
                        <thead class="bg-surface-container-low text-on-surface-variant">
                            <tr>
                                <th class="px-5 py-4 font-medium">Mã lớp</th>
                                <th class="px-5 py-4 font-medium">Tên lớp</th>
                                <th class="px-5 py-4 font-medium">Ngôn ngữ</th>
                                <th class="px-5 py-4 font-medium">Khóa học</th>
                                <th class="px-5 py-4 font-medium">Giáo viên</th>
                                <th class="px-5 py-4 font-medium">Sĩ số</th>
                                <th class="px-5 py-4 font-medium">Ca học</th>
                                <th class="px-5 py-4 font-medium">Trạng thái</th>
                                <th class="px-5 py-4 font-medium text-right">Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="danhSachLop">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var lop in Model)
                            {
                                var mauTrangThai = lop.TrangThai == "Đang học"
                                    ? "bg-emerald-100 text-emerald-700"
                                    : lop.TrangThai == "Sắp khai giảng"
                                        ? "bg-amber-100 text-amber-700"
                                        : "bg-gray-100 text-gray-600";

                                <tr class="dong-lop border-t border-outline-variant hover:bg-surface-container-low"
    data-ngon-ngu="@lop.NgonNgu">
                                    <td class="px-5 py-4">
                                        <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary">@lop.MaLop</span>
                                    </td>
                                    <td class="px-5 py-4 font-medium">@lop.TenLop</td>
                                    <td class="px-5 py-4 text-on-surface-variant">@lop.NgonNgu</td>
                                    <td class="px-5 py-4 text-on-surface-variant">@lop.KhoaHoc</td>
                                    <td class="px-5 py-4">@lop.GiaoVien</td>
                                    <td class="px-5 py-4">@lop.SiSoHienTai/@lop.SiSoToiDa</td>
                                    <td class="px-5 py-4 text-on-surface-variant">@lop.CaHoc</td>
                                    <td class="px-5 py-4">
                                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium @mauTrangThai">@lop.TrangThai</span>
                                    </td>
                                    <td class="px-5 py-4 text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            <button type="button"
       onclick='moModalSuaLop(
    @lop.Id,
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.TenLop)),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.KhoaHoc)),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.NgonNgu)),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.GiaoVien)),
    @lop.SiSoToiDa,
    @lop.SiSoHienTai,
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.NgayHoc ?? "")),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.GioBatDau ?? "")),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.GioKetThuc ?? "")),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.PhongHoc ?? "")),
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.TrangThai))
)'
        class="text-sm font-medium text-blue-600 hover:underline">Sửa</button>
                                            <button type="button"
                                                    onclick='moModalXoaLop(@lop.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lop.TenLop)))'
                                                    class="text-sm font-medium text-red-600 hover:underline">Xóa</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="px-6 py-10 text-center text-on-surface-variant">Chưa có lớp học nào.</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- ================= MODAL THÊM LỚP ================= -->
<div id="modalThemLop" class="hidden fixed inset-0 z-[9999] bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant sticky top-0 bg-white z-10">
            <div>
                <h2 class="text-xl font-bold text-primary">Tạo lớp mới</h2>
                <p class="text-sm text-on-surface-variant mt-1">Mã lớp sẽ được hệ thống tự động tạo.</p>
            </div>
            <button type="button" onclick="dongModalThemLop()" class="w-9 h-9 rounded-lg hover:bg-surface-container flex items-center justify-center">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form asp-controller="QuanLy" asp-action="ThemLopHoc" method="post" class="p-6">
            @Html.AntiForgeryToken()

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Tên lớp</label>
                <input type="text" name="tenLop" required placeholder="Ví dụ: Lớp A1, IELTS-101..."
                       class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Ngôn ngữ</label>
                <select name="ngonNgu" id="themNgonNgu" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20"
                        onchange="locTheoNgonNgu('them')">
                    <option value="">-- Chọn ngôn ngữ --</option>
                    <option value="Tiếng Anh">Tiếng Anh</option>
                    <option value="Tiếng Trung">Tiếng Trung</option>
                    <option value="Tiếng Nhật">Tiếng Nhật</option>
                    <option value="Tiếng Hàn">Tiếng Hàn</option>
                </select>
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Khóa học</label>
                <select name="khoaHoc" id="themKhoaHoc" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">-- Chọn khóa học --</option>
                </select>
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Giáo viên</label>
                <select name="giaoVien" id="themGiaoVien" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">-- Chọn giáo viên --</option>
                </select>
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Sĩ số tối đa</label>
                <input type="number" name="siSoToiDa" min="1" required value="20"
                       class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <!-- Ngày học -->
            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Ngày học</label>
                <div class="flex flex-wrap gap-3 text-sm">
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T2" class="rounded"> T2</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T3" class="rounded"> T3</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T4" class="rounded"> T4</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T5" class="rounded"> T5</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T6" class="rounded"> T6</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T7" class="rounded"> T7</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="CN" class="rounded"> CN</label>
                </div>
            </div>

            <!-- Chọn nhanh ca -->
            <div class="mb-3">
                <label class="block text-sm font-medium mb-2">Chọn nhanh ca</label>
                <div class="flex flex-wrap gap-2">
                    <button type="button" onclick="chonCaNhanh('07:30','09:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Sáng (07:30–09:30)</button>
                    <button type="button" onclick="chonCaNhanh('13:30','15:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Chiều (13:30–15:30)</button>
                    <button type="button" onclick="chonCaNhanh('15:30','17:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Chiều muộn (15:30–17:30)</button>
                    <button type="button" onclick="chonCaNhanh('17:30','19:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối sớm (17:30–19:30)</button>
                    <button type="button" onclick="chonCaNhanh('18:00','20:00')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối (18:00–20:00)</button>
                    <button type="button" onclick="chonCaNhanh('18:30','20:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối (18:30–20:30)</button>
                    <button type="button" onclick="chonCaNhanh('19:00','21:00')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối muộn (19:00–21:00)</button>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-sm font-medium mb-2">Giờ bắt đầu</label>
                    <input type="time" name="gioBatDau" id="themGioBatDau" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Giờ kết thúc</label>
                    <input type="time" name="gioKetThuc" id="themGioKetThuc" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Phòng học</label>
                <select name="phongHoc" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">-- Chọn phòng --</option>
                    @for (int i = 1; i <= 20; i++)
                    {
                        <option value="@($"P{i:D2}")">Phòng @($"P{i:D2}")</option>
                    }
                </select>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Trạng thái</label>
                <select name="trangThai" required class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="Sắp khai giảng">Sắp khai giảng</option>
                    <option value="Đang học">Đang học</option>
                    <option value="Đã kết thúc">Đã kết thúc</option>
                </select>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" onclick="dongModalThemLop()" class="px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium hover:bg-surface-container">Hủy</button>
                <button type="submit" class="px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:opacity-90 transition">Tạo lớp</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL SỬA LỚP ================= -->
<div id="modalSuaLop" class="hidden fixed inset-0 z-[9999] bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant sticky top-0 bg-white z-10">
            <div>
                <h2 class="text-xl font-bold text-primary">Sửa lớp học</h2>
                <p class="text-sm text-on-surface-variant mt-1">Cập nhật thông tin lớp</p>
            </div>
            <button type="button" onclick="dongModalSuaLop()" class="w-9 h-9 rounded-lg hover:bg-surface-container flex items-center justify-center">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form asp-controller="QuanLy" asp-action="SuaLopHoc" method="post" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="suaId" />

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Tên lớp</label>
                <input type="text" name="tenLop" id="suaTenLop" required
                       class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Ngôn ngữ</label>
                <select name="ngonNgu" id="suaNgonNgu" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20"
                        onchange="locTheoNgonNgu('sua')">
                    <option value="">-- Chọn ngôn ngữ --</option>
                    <option value="Tiếng Anh">Tiếng Anh</option>
                    <option value="Tiếng Trung">Tiếng Trung</option>
                    <option value="Tiếng Nhật">Tiếng Nhật</option>
                    <option value="Tiếng Hàn">Tiếng Hàn</option>
                </select>
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Khóa học</label>
                <select name="khoaHoc" id="suaKhoaHoc" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">-- Chọn khóa học --</option>
                </select>
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Giáo viên</label>
                <select name="giaoVien" id="suaGiaoVien" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">-- Chọn giáo viên --</option>
                </select>
            </div>

            <div class="mb-5 grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-2">Sĩ số tối đa</label>
                    <input type="number" name="siSoToiDa" id="suaSiSoToiDa" min="1" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Sĩ số hiện tại</label>
                    <input type="number" name="siSoHienTai" id="suaSiSoHienTai" min="0" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
            </div>

            <!-- Ngày học -->
            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Ngày học</label>
                <div class="flex flex-wrap gap-3 text-sm">
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T2" id="suaT2" class="rounded"> T2</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T3" id="suaT3" class="rounded"> T3</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T4" id="suaT4" class="rounded"> T4</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T5" id="suaT5" class="rounded"> T5</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T6" id="suaT6" class="rounded"> T6</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="T7" id="suaT7" class="rounded"> T7</label>
                    <label class="flex items-center gap-1"><input type="checkbox" name="ngayHoc" value="CN" id="suaCN" class="rounded"> CN</label>
                </div>
            </div>

            <!-- Chọn nhanh ca (Sửa) -->
            <div class="mb-3">
                <label class="block text-sm font-medium mb-2">Chọn nhanh ca</label>
                <div class="flex flex-wrap gap-2">
                    <button type="button" onclick="chonCaNhanhSua('07:30','09:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Sáng (07:30–09:30)</button>
                    <button type="button" onclick="chonCaNhanhSua('13:30','15:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Chiều (13:30–15:30)</button>
                    <button type="button" onclick="chonCaNhanhSua('15:30','17:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Chiều muộn (15:30–17:30)</button>
                    <button type="button" onclick="chonCaNhanhSua('17:30','19:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối sớm (17:30–19:30)</button>
                    <button type="button" onclick="chonCaNhanhSua('18:00','20:00')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối (18:00–20:00)</button>
                    <button type="button" onclick="chonCaNhanhSua('18:30','20:30')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối (18:30–20:30)</button>
                    <button type="button" onclick="chonCaNhanhSua('19:00','21:00')" class="px-3 py-1.5 rounded-lg border border-outline-variant text-sm hover:bg-surface-container">Tối muộn (19:00–21:00)</button>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-sm font-medium mb-2">Giờ bắt đầu</label>
                    <input type="time" name="gioBatDau" id="suaGioBatDau" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Giờ kết thúc</label>
                    <input type="time" name="gioKetThuc" id="suaGioKetThuc" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Phòng học</label>
                <select name="phongHoc" id="suaPhongHoc" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">-- Chọn phòng --</option>
                    @for (int i = 1; i <= 20; i++)
                    {
                        <option value="@($"P{i:D2}")">Phòng @($"P{i:D2}")</option>
                    }
                </select>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Trạng thái</label>
                <select name="trangThai" id="suaTrangThai" required
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="Sắp khai giảng">Sắp khai giảng</option>
                    <option value="Đang học">Đang học</option>
                    <option value="Đã kết thúc">Đã kết thúc</option>
                </select>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" onclick="dongModalSuaLop()" class="px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium hover:bg-surface-container">Hủy</button>
                <button type="submit" class="px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:opacity-90 transition">Cập nhật</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL XÓA ================= -->
<div id="modalXoaLop" class="hidden fixed inset-0 z-[9999] bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md">
        <div class="p-6">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center">
                    <span class="material-symbols-outlined text-red-600">warning</span>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-primary">Xác nhận xóa</h2>
                    <p class="text-sm text-on-surface-variant mt-1">Bạn có chắc muốn xóa lớp này?</p>
                </div>
            </div>
            <p class="text-sm mb-6">Lớp: <strong id="tenLopXoa"></strong></p>
            <form asp-controller="QuanLy" asp-action="XoaLopHoc" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="xoaId" />
                <div class="flex justify-end gap-3">
                    <button type="button" onclick="dongModalXoaLop()" class="px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium hover:bg-surface-container">Hủy</button>
                    <button type="submit" class="px-5 py-2.5 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition">Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="application/json" id="khoaHocData">
@Html.Raw(ViewBag.DanhSachKhoaHocJson ?? "[]")
</script>
<script type="application/json" id="giaoVienData">
@Html.Raw(ViewBag.DanhSachGiaoVienJson ?? "[]")
</script>

<script>
    let danhSachKhoaHocFull = [];
    let danhSachGiaoVienFull = [];
    try {
        var elKH = document.getElementById("khoaHocData");
        if (elKH) danhSachKhoaHocFull = JSON.parse(elKH.textContent.trim() || "[]");
        var elGV = document.getElementById("giaoVienData");
        if (elGV) danhSachGiaoVienFull = JSON.parse(elGV.textContent.trim() || "[]");
    } catch (e) {
        console.error("Lỗi đọc dữ liệu:", e);
    }

    console.log("Khóa học:", danhSachKhoaHocFull);
    console.log("Giáo viên:", danhSachGiaoVienFull);

    // Lọc cả khóa học + giáo viên theo ngôn ngữ
    function locTheoNgonNgu(loai, selectedKhoaHoc, selectedGiaoVien) {
        selectedKhoaHoc = selectedKhoaHoc || "";
        selectedGiaoVien = selectedGiaoVien || "";

        var ngonNguSelect = document.getElementById(loai === "them" ? "themNgonNgu" : "suaNgonNgu");
        var selectKH = document.getElementById(loai === "them" ? "themKhoaHoc" : "suaKhoaHoc");
        var selectGV = document.getElementById(loai === "them" ? "themGiaoVien" : "suaGiaoVien");
        var ngonNgu = ngonNguSelect ? ngonNguSelect.value : "";

        // Lọc khóa học
        if (selectKH) {
            selectKH.innerHTML = '<option value="">-- Chọn khóa học --</option>';
            if (ngonNgu) {
                for (var i = 0; i < danhSachKhoaHocFull.length; i++) {
                    var kh = danhSachKhoaHocFull[i];
                    if (kh.ngonNgu === ngonNgu) {
                        var opt = document.createElement("option");
                        opt.value = kh.ten;
                        opt.textContent = kh.ten;
                        if (kh.ten === selectedKhoaHoc) opt.selected = true;
                        selectKH.appendChild(opt);
                    }
                }
            }
        }

        // Lọc giáo viên
        if (selectGV) {
            selectGV.innerHTML = '<option value="">-- Chọn giáo viên --</option>';
            if (ngonNgu) {
                for (var j = 0; j < danhSachGiaoVienFull.length; j++) {
                    var gv = danhSachGiaoVienFull[j];
                    if (gv.ngonNgu === ngonNgu) {
                        var opt2 = document.createElement("option");
                        opt2.value = gv.ten;
                        opt2.textContent = gv.ten;
                        if (gv.ten === selectedGiaoVien) opt2.selected = true;
                        selectGV.appendChild(opt2);
                    }
                }
            }
        }
    }

    function moModalThemLop() {
        document.getElementById("modalThemLop").classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
        var ngonNgu = document.getElementById("themNgonNgu");
        if (ngonNgu) ngonNgu.value = "";
        locTheoNgonNgu("them", "", "");
    }

    function dongModalThemLop() {
        document.getElementById("modalThemLop").classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
    }

    function moModalSuaLop(id, tenLop, khoaHoc, ngonNgu, giaoVien, siSoToiDa, siSoHienTai, ngayHoc, gioBatDau, gioKetThuc, phongHoc, trangThai) {
    document.getElementById("suaId").value = id;
    document.getElementById("suaTenLop").value = tenLop || "";
    document.getElementById("suaNgonNgu").value = ngonNgu || "";
    document.getElementById("suaSiSoToiDa").value = siSoToiDa != null ? siSoToiDa : 20;
    document.getElementById("suaSiSoHienTai").value = siSoHienTai != null ? siSoHienTai : 0;
    document.getElementById("suaTrangThai").value = trangThai || "Sắp khai giảng";

    // Reset checkbox ngày học
    ["T2", "T3", "T4", "T5", "T6", "T7", "CN"].forEach(function (t) {
        var cb = document.getElementById("sua" + t);
        if (cb) cb.checked = false;
    });

    // Tick các ngày đã chọn (ngayHoc dạng "T2,T4,T6")
    if (ngayHoc) {
        ngayHoc.split(",").forEach(function (t) {
            var cb = document.getElementById("sua" + t.trim().toUpperCase());
            if (cb) cb.checked = true;
        });
    }

    document.getElementById("suaGioBatDau").value = gioBatDau || "";
    document.getElementById("suaGioKetThuc").value = gioKetThuc || "";
    document.getElementById("suaPhongHoc").value = phongHoc || "";

    // Lọc khóa học + giáo viên theo ngôn ngữ, giữ giá trị cũ
    locTheoNgonNgu("sua", khoaHoc || "", giaoVien || "");

    document.getElementById("modalSuaLop").classList.remove("hidden");
    document.body.classList.add("overflow-hidden");
}

function dongModalSuaLop() {
    document.getElementById("modalSuaLop").classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
}

function moModalXoaLop(id, ten) {
    document.getElementById("xoaId").value = id;
    document.getElementById("tenLopXoa").textContent = ten || "";
    document.getElementById("modalXoaLop").classList.remove("hidden");
    document.body.classList.add("overflow-hidden");
}

function dongModalXoaLop() {
    document.getElementById("modalXoaLop").classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
}

// ==============================
// LỌC DANH SÁCH LỚP THEO NGÔN NGỮ
// ==============================
function locDanhSachLop() {
    var tuKhoa = (document.getElementById("timKiemLop")?.value || "").toLowerCase().trim();
    var ngonNgu = (document.getElementById("locNgonNguLop")?.value || "").trim();

    document.querySelectorAll(".dong-lop").forEach(function (dong) {
        var matchText = dong.innerText.toLowerCase().includes(tuKhoa);
        var ngonNguDong = (dong.getAttribute("data-ngon-ngu") || "").trim();
        var matchNgonNgu = !ngonNgu || ngonNguDong === ngonNgu;

        dong.style.display = (matchText && matchNgonNgu) ? "" : "none";
    });
}

var timKiemLop = document.getElementById("timKiemLop");
if (timKiemLop) {
    timKiemLop.addEventListener("input", locDanhSachLop);
}

var locNgonNguLop = document.getElementById("locNgonNguLop");
if (locNgonNguLop) {
    locNgonNguLop.addEventListener("change", locDanhSachLop);
}

window.addEventListener("click", function (e) {
    ["modalThemLop", "modalSuaLop", "modalXoaLop"].forEach(function (id) {
        var m = document.getElementById(id);
        if (e.target === m) {
            m.classList.add("hidden");
            document.body.classList.remove("overflow-hidden");
        }
    });
});

document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
        ["modalThemLop", "modalSuaLop", "modalXoaLop"].forEach(function (id) {
            document.getElementById(id).classList.add("hidden");
        });
        document.body.classList.remove("overflow-hidden");
    }
});
</script>
<!-- CHATBOT NỔI (GÓC DƯỚI BÊN PHẢI) -->
<div id="oChatbotPanel"
     class="hidden fixed bottom-24 right-6 z-50 w-[360px] max-w-[92vw] h-[480px] max-h-[75vh] bg-white rounded-xl border border-outline-variant shadow-2xl flex flex-col overflow-hidden">

    <div class="bg-primary text-white px-4 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
            </div>
            <div>
                <div class="text-sm font-semibold">Trợ lý AI</div>
                <div class="text-xs text-white/70">Luôn sẵn sàng hỗ trợ</div>
            </div>
        </div>
        <button type="button" onclick="dongChatbot()"
                class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/10 transition">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div id="oChatMessages"
         class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 bg-surface">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                Xin chào! Tôi có thể giúp gì cho bạn hôm nay?
            </div>
        </div>
    </div>

    <form onsubmit="guiTinNhanChatbot(event)"
          class="border-t border-surface-variant p-3 flex items-center gap-2 shrink-0 bg-white">
        <input id="oChatInput"
               type="text"
               autocomplete="off"
               placeholder="Nhập câu hỏi của bạn..."
               class="flex-1 rounded-lg border border-outline-variant px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
        <button type="submit"
                class="w-10 h-10 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center hover:opacity-90 transition">
            <span class="material-symbols-outlined text-[20px]">send</span>
        </button>
    </form>
</div>

<!-- NÚT MỞ CHATBOT -->
<button id="oChatbotToggle"
        type="button"
        onclick="moChatbot()"
        class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[26px]">smart_toy</span>
</button>

<script>
    function moChatbot() {
        document.getElementById("oChatbotPanel").classList.remove("hidden");
        document.getElementById("oChatbotToggle").classList.add("hidden");
        document.getElementById("oChatInput").focus();
    }

    function dongChatbot() {
        document.getElementById("oChatbotPanel").classList.add("hidden");
        document.getElementById("oChatbotToggle").classList.remove("hidden");
    }

    function themTinNhanChatbot(noiDung, nguoiGui) {
        const oChatMessages = document.getElementById("oChatMessages");
        const dong = document.createElement("div");

        if (nguoiGui === "nguoiDung") {
            dong.className = "flex items-start gap-2 justify-end";
            dong.innerHTML = `
                <div class="bg-primary text-white rounded-xl rounded-tr-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;
        } else {
            dong.className = "flex items-start gap-2";
            dong.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[16px]">smart_toy</span>
                </div>
                <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;
        }

        oChatMessages.appendChild(dong);
        oChatMessages.scrollTop = oChatMessages.scrollHeight;
    }

    async function guiTinNhanChatbot(su) {
        su.preventDefault();

        const oChatInput = document.getElementById("oChatInput");
        const noiDung = oChatInput.value.trim();
        if (!noiDung) return;

        themTinNhanChatbot(noiDung, "nguoiDung");
        oChatInput.value = "";

        // Tạm thời trả lời mẫu (sau này gắn API AI)
        try {
            themTinNhanChatbot("Đang xử lý...", "bot");
            const response = await fetch("/api/chatbot", { method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin", body: JSON.stringify({ message: noiDung }) });
            const data = await response.json();
            const messages = document.getElementById("oChatMessages");
            if (messages.lastElementChild?.textContent.includes("Đang xử lý...")) messages.lastElementChild.remove();
            themTinNhanChatbot(response.ok ? (data.answer || "AI không trả về câu trả lời.") : (data.message || "Có lỗi xảy ra khi kết nối với chatbot."), "bot");
        } catch (error) {
            console.error("Lỗi chatbot:", error);
            themTinNhanChatbot("Không thể kết nối đến máy chủ chatbot.", "bot");
        }
    }
    function chonCaNhanh(batDau, ketThuc) {
    var bd = document.getElementById("themGioBatDau");
    var kt = document.getElementById("themGioKetThuc");
    if (bd) bd.value = batDau;
    if (kt) kt.value = ketThuc;
}

function chonCaNhanhSua(batDau, ketThuc) {
    var bd = document.getElementById("suaGioBatDau");
    var kt = document.getElementById("suaGioKetThuc");
    if (bd) bd.value = batDau;
    if (kt) kt.value = ketThuc;
}
</script>
<script src="~/js/chatbot-history.js" asp-append-version="true"></script>
</body>
</html>