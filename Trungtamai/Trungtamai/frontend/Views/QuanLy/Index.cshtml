@{
    Layout = null;
    var hoTen = ViewBag.HoTen ?? "Quản lý";
    var tongHocVien = ViewBag.TongHocVien ?? 0;
    var tongGiaoVien = ViewBag.TongGiaoVien ?? 0;
    var lopDangHoatDong = ViewBag.LopDangHoatDong ?? 0;
    var doanhThuThang = ViewBag.DoanhThuThang ?? 0m;
    var lichHomNay = ViewBag.LichHomNay as List<Trungtamai.Models.LopHoc> ?? new List<Trungtamai.Models.LopHoc>();
    var soLopAnh = ViewBag.SoLopAnh ?? 0;
    var soLopTrung = ViewBag.SoLopTrung ?? 0;
    var soLopNhat = ViewBag.SoLopNhat ?? 0;
    var soLopHan = ViewBag.SoLopHan ?? 0;
    var pctAnh = ViewBag.PctAnh ?? 0;
    var pctTrung = ViewBag.PctTrung ?? 0;
    var pctNhat = ViewBag.PctNhat ?? 0;
    var pctHan = ViewBag.PctHan ?? 0;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8">

    <meta name="viewport"

          content="width=device-width, initial-scale=1.0">

    <title>Quản lý - LinguistAI</title>

    <!-- Tailwind -->

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Inter -->

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"

          rel="stylesheet">

    <!-- Material Symbols -->

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1"

          rel="stylesheet">

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: "#091426",

                        "primary-container": "#1e293b",

                        "on-primary": "#ffffff",

                        background: "#f7f9fb",

                        surface: "#f7f9fb",

                        "surface-container-low": "#f2f4f6",

                        "surface-container": "#eceef0",

                        "surface-container-high": "#e6e8ea",

                        "surface-container-lowest": "#ffffff",

                        "surface-variant": "#e0e3e5",

                        "outline-variant": "#c5c6cd",

                        "on-surface": "#191c1e",

                        "on-surface-variant": "#45474c",

                        secondary: "#006a61",

                        error: "#ba1a1a"

                    },

                    fontFamily: {

                        sans: ["Inter"]

                    },

                    borderRadius: {

                        lg: "0.5rem",

                        xl: "0.75rem"

                    }

                }

            }

        };

    </script>



    <style>

        * {

            box-sizing: border-box;

        }

        body {

            font-family: 'Inter', sans-serif;

        }

        .sidebar-item {

            transition: all 0.2s ease;

        }

        .sidebar-item:hover {

            background: #e6e8ea;

        }

        .sidebar-item.active {

            background: #091426;

            color: white;

        }

        .stat-card {

            transition: all 0.2s ease;

        }

        .stat-card:hover {

            transform: translateY(-2px);

            box-shadow: 0 8px 20px rgba(0,0,0,0.06);

        }

        .table-row {

            transition: *background* 0.15s ease;

        }

        .table-row:hover {

            background: #f7f9fb;

        }

    </style>

</head>



<body class="bg-background text-on-surface">



<div class="min-h-screen flex">



    <!-- ================================================= -->

    <!-- SIDEBAR -->

    <!-- ================================================= -->

    <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">



        <!-- LOGO -->

        <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">

            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">

                <span class="material-symbols-outlined"

                      style="font-variation-settings:'FILL' 1">

                    school

                </span>

            </div>



            <div>

                <div class="font-bold text-primary text-lg">

                    LinguistAI

                </div>

                <div class="text-xs text-on-surface-variant">

                    Quản lý trung tâm

                </div>

            </div>

        </div>



        <!-- MENU -->

        <nav class="flex-1 px-3 py-5 space-y-1">
<a asp-controller="QuanLy" asp-action="Index" class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
    <span class="material-symbols-outlined">dashboard</span>
    Tổng quan
</a>

<a asp-controller="QuanLy" asp-action="HocVien" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">group</span>
    Học viên
</a>

<a asp-controller="QuanLy" asp-action="GiaoVien" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">person</span>
    Giáo viên
</a>

<a asp-controller="QuanLy" asp-action="KhoaHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">menu_book</span>
    Khóa học
</a>

<a asp-controller="QuanLy" asp-action="LopHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">groups</span>
    Lớp học
</a>

<a asp-controller="QuanLy" asp-action="LichHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">calendar_month</span>
    Lịch học
</a>

<a asp-controller="QuanLy" asp-action="HocPhi" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">payments</span>
    Học phí
</a>

<a asp-controller="QuanLy" asp-action="KetQuaHocTap" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">assessment</span>
    Kết quả học tập
</a>

<a asp-controller="QuanLy" asp-action="ThongKe" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">bar_chart</span>
    Thống kê
</a>
        </nav>



        <!-- USER / LOGOUT -->

        <div class="border-t border-surface-variant p-4">



            <div class="flex items-center gap-3 mb-3">



                <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">

                    @(hoTen.ToString().Substring(0, 1).ToUpper())

                </div>



                <div class="min-w-0">

                    <div class="font-medium text-sm truncate">

                        @hoTen

                    </div>

                    <div class="text-xs text-on-surface-variant">

                        Quản lý

                    </div>

                </div>

            </div>







        </div>



    </aside>





    <!-- ================================================= -->

    <!-- MAIN -->

    <!-- ================================================= -->

    <main class="ml-[250px] flex-1 min-h-screen">



        <!-- TOPBAR -->

        <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8">



            <div>

                <h1 class="text-xl font-semibold text-primary">

                    Tổng quan

                </h1>

                <p class="text-sm text-on-surface-variant mt-1">

                    Quản lý hoạt động của trung tâm

                </p>

            </div>







            <div class="flex items-center gap-4">
                <a asp-controller="Account"
                   asp-action="Logout"
                   class="flex items-center gap-2 px-4 py-2 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
                    <span class="material-symbols-outlined text-[20px]">
                        logout
                    </span>
                    Đăng xuất
                </a>
            </div>

        </header>





        <!-- CONTENT -->

        <div class="p-8">



            <!-- WELCOME -->

            <div class="mb-8">

                <h2 class="text-2xl font-semibold text-primary">

                    Xin chào, @hoTen 👋

                </h2>

                <p class="text-on-surface-variant mt-1">

                    Đây là tổng quan hoạt động của trung tâm ngoại ngữ.

                </p>

            </div>





            <!-- ================================================= -->

            <!-- STATISTICS -->

            <!-- ================================================= -->

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">



                <!-- HỌC VIÊN -->

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">

                    <div class="flex items-center justify-between">

                        <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">

                            <span class="material-symbols-outlined text-primary">

                                group

                            </span>

                        </div>

                        <span class="text-xs text-secondary font-medium">

                            +0%

                        </span>

                    </div>



                    <div class="mt-5">

                        <div class="text-sm text-on-surface-variant">

                            Tổng học viên

                        </div>

                        <div class="text-3xl font-semibold text-primary mt-1">
    @tongHocVien
</div>

                    </div>

                </div>



                <!-- GIÁO VIÊN -->

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">

                    <div class="flex items-center justify-between">

                        <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">

                            <span class="material-symbols-outlined text-primary">

                                person

                            </span>

                        </div>

                    </div>



                    <div class="mt-5">

                        <div class="text-sm text-on-surface-variant">

                            Giáo viên

                        </div>

                        <div class="text-3xl font-semibold text-primary mt-1">
    @tongGiaoVien
</div>

                    </div>

                </div>



                <!-- LỚP -->

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">

                    <div class="flex items-center justify-between">

                        <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">

                            <span class="material-symbols-outlined text-primary">

                                groups

                            </span>

                        </div>

                    </div>



                    <div class="mt-5">

                        <div class="text-sm text-on-surface-variant">

                            Lớp đang hoạt động

                        </div>

                        <div class="text-3xl font-semibold text-primary mt-1">
    @lopDangHoatDong
</div>

                    </div>

                </div>



                <!-- DOANH THU -->

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">

                    <div class="flex items-center justify-between">

                        <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">

                            <span class="material-symbols-outlined text-primary">

                                payments

                            </span>

                        </div>

                    </div>



                    <div class="mt-5">

                        <div class="text-sm text-on-surface-variant">

                            Doanh thu tháng

                        </div>

                        <div class="text-3xl font-semibold text-primary mt-1">
    @string.Format("{0:N0} ₫", doanhThuThang)
</div>

                    </div>

                </div>



            </div>





            <!-- ================================================= -->

            <!-- TWO COLUMNS -->

            <!-- ================================================= -->

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">



                <!-- LỊCH HỌC -->

                <div class="xl:col-span-2 bg-white rounded-xl border border-outline-variant">



                    <div class="p-6 border-b border-surface-variant flex items-center justify-between">

                        <div>

                            <h3 class="font-semibold text-primary">

                                Lịch học hôm nay

                            </h3>

                            <p class="text-sm text-on-surface-variant mt-1">

                                Các lớp đang diễn ra trong ngày

                            </p>

                        </div>



                        <a asp-controller="QuanLy" asp-action="LichHoc"
   class="text-sm font-medium text-secondary hover:underline">
    Xem tất cả
</a>

                    </div>



                    <div class="overflow-x-auto">

                        <table class="w-full text-sm">

                            <thead>

                                <tr class="border-b border-surface-variant text-left">

                                    <th class="px-6 py-4 font-medium text-on-surface-variant">

                                        Lớp

                                    </th>

                                    <th class="px-6 py-4 font-medium text-on-surface-variant">

                                        Giáo viên

                                    </th>

                                    <th class="px-6 py-4 font-medium text-on-surface-variant">

                                        Thời gian

                                    </th>

                                    <th class="px-6 py-4 font-medium text-on-surface-variant">

                                        Phòng

                                    </th>

                                </tr>

                            </thead>



                            <tbody>
@if (lichHomNay != null && lichHomNay.Any())
{
    foreach (var lop in lichHomNay)
    {
        <tr class="table-row border-b border-surface-variant">
            <td class="px-6 py-4 font-medium">@lop.TenLop</td>
            <td class="px-6 py-4">@lop.GiaoVien</td>
            <td class="px-6 py-4 text-on-surface-variant">@lop.GioBatDau – @lop.GioKetThuc</td>
            <td class="px-6 py-4">@lop.PhongHoc</td>
        </tr>
    }
}
else
{
    <tr class="table-row border-b border-surface-variant">
        <td colspan="4" class="px-6 py-10 text-center text-on-surface-variant">
            Chưa có lịch học hôm nay
        </td>
    </tr>
}
</tbody>

                        </table>

                    </div>

                </div>





                <!-- THỐNG KÊ KHÓA HỌC -->

                <div class="bg-white rounded-xl border border-outline-variant">



                    <div class="p-6 border-b border-surface-variant">

                        <h3 class="font-semibold text-primary">

                            Khóa học

                        </h3>

                        <p class="text-sm text-on-surface-variant mt-1">

                            Tình hình khóa học

                        </p>

                    </div>



                    <div class="p-6 space-y-5">

    <!-- Tiếng Anh -->
    <div>
        <div class="flex justify-between mb-2 text-sm">
            <span>Tiếng Anh</span>
            <span class="font-medium">@soLopAnh lớp</span>
        </div>
        <div class="h-2 rounded-full bg-surface-container">
            <div class="h-2 rounded-full bg-primary" style="width:@(pctAnh)%"></div>
        </div>
    </div>

    <!-- Tiếng Trung -->
    <div>
        <div class="flex justify-between mb-2 text-sm">
            <span>Tiếng Trung</span>
            <span class="font-medium">@soLopTrung lớp</span>
        </div>
        <div class="h-2 rounded-full bg-surface-container">
            <div class="h-2 rounded-full bg-emerald-500" style="width:@(pctTrung)%"></div>
        </div>
    </div>

    <!-- Tiếng Nhật -->
    <div>
        <div class="flex justify-between mb-2 text-sm">
            <span>Tiếng Nhật</span>
            <span class="font-medium">@soLopNhat lớp</span>
        </div>
        <div class="h-2 rounded-full bg-surface-container">
            <div class="h-2 rounded-full bg-amber-500" style="width:@(pctNhat)%"></div>
        </div>
    </div>

    <!-- Tiếng Hàn -->
    <div>
        <div class="flex justify-between mb-2 text-sm">
            <span>Tiếng Hàn</span>
            <span class="font-medium">@soLopHan lớp</span>
        </div>
        <div class="h-2 rounded-full bg-surface-container">
            <div class="h-2 rounded-full bg-rose-500" style="width:@(pctHan)%"></div>
        </div>
    </div>

</div>

                </div>



            </div>





            <!-- ================================================= -->

            <!-- QUICK ACTIONS -->

            <!-- ================================================= -->

            <div class="mt-6 bg-white rounded-xl border border-outline-variant p-6">



                <h3 class="font-semibold text-primary">

                    Quản lý nhanh

                </h3>

                <p class="text-sm text-on-surface-variant mt-1 mb-5">

                    Các chức năng thường sử dụng

                </p>



                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

    <!-- Thêm học viên -->
    <a asp-controller="QuanLy" asp-action="HocVien"
       class="border border-outline-variant rounded-lg p-4 text-left hover:bg-surface-container transition block">
        <span class="material-symbols-outlined text-primary">person_add</span>
        <div class="font-medium text-sm mt-3">Thêm học viên</div>
    </a>

    <!-- Thêm giáo viên -->
    <a asp-controller="QuanLy" asp-action="GiaoVien"
       class="border border-outline-variant rounded-lg p-4 text-left hover:bg-surface-container transition block">
        <span class="material-symbols-outlined text-primary">school</span>
        <div class="font-medium text-sm mt-3">Thêm giáo viên</div>
    </a>

    <!-- Tạo lớp học -->
    <a asp-controller="QuanLy" asp-action="LopHoc"
       class="border border-outline-variant rounded-lg p-4 text-left hover:bg-surface-container transition block">
        <span class="material-symbols-outlined text-primary">add_box</span>
        <div class="font-medium text-sm mt-3">Tạo lớp học</div>
    </a>

    <!-- Quản lý học phí -->
    <a asp-controller="QuanLy" asp-action="HocPhi"
       class="border border-outline-variant rounded-lg p-4 text-left hover:bg-surface-container transition block">
        <span class="material-symbols-outlined text-primary">payments</span>
        <div class="font-medium text-sm mt-3">Quản lý học phí</div>
    </a>

</div>

            </div>



        </div>

    </main>

</div>


<!-- ================================================= -->
<!-- CHATBOT NỔI (GÓC DƯỚI BÊN PHẢI) -->
<!-- ================================================= -->

<div id="oChatbotPanel"
     class="hidden fixed bottom-24 right-6 z-[99999] w-[360px] max-w-[92vw] h-[480px] max-h-[75vh] bg-white rounded-xl border border-outline-variant shadow-2xl flex flex-col overflow-hidden">

    <div class="bg-primary text-white px-4 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
            </div>
            <div>
                <div class="text-sm font-semibold">Trợ lý AI</div>
                <div class="text-xs text-white/70">Luôn sẵn sàng hỗ trợ</div>
            </div>
        </div>
        <button onclick="dongChatbot()"
                class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/10 transition">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div id="oChatMessages"
         class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 bg-surface">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                Xin chào! Tôi có thể giúp gì cho bạn hôm nay?
            </div>
        </div>
    </div>

    <form onsubmit="guiTinNhanChatbot(event)"
          class="border-t border-surface-variant p-3 flex items-center gap-2 shrink-0 bg-white">
        <input id="oChatInput"
               type="text"
               autocomplete="off"
               placeholder="Nhập câu hỏi của bạn..."
               class="flex-1 rounded-lg border border-outline-variant px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
        <button type="submit"
                class="w-10 h-10 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center hover:opacity-90 transition">
            <span class="material-symbols-outlined text-[20px]">send</span>
        </button>
    </form>

</div>

<button id="oChatbotToggle"
        onclick="moChatbot()"
        class="fixed bottom-6 right-6 z-[99999] w-14 h-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[26px]">
        smart_toy
    </span>
</button>

<script>

    function moChatbot() {
        document.getElementById("oChatbotPanel").classList.remove("hidden");
        document.getElementById("oChatbotToggle").classList.add("hidden");
        document.getElementById("oChatInput").focus();
    }

    function dongChatbot() {
        document.getElementById("oChatbotPanel").classList.add("hidden");
        document.getElementById("oChatbotToggle").classList.remove("hidden");
    }

    function themTinNhanChatbot(noiDung, nguoiGui) {

        const oChatMessages = document.getElementById("oChatMessages");
        const dong = document.createElement("div");

        if (nguoiGui === "nguoiDung") {

            dong.className = "flex items-start gap-2 justify-end";
            dong.innerHTML = `
                <div class="bg-primary text-white rounded-xl rounded-tr-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;

        } else {

            dong.className = "flex items-start gap-2";
            dong.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[16px]">smart_toy</span>
                </div>
                <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;

        }

        oChatMessages.appendChild(dong);
        oChatMessages.scrollTop = oChatMessages.scrollHeight;

    }

    async function guiTinNhanChatbot(su) {

        su.preventDefault();

        const oChatInput = document.getElementById("oChatInput");
        const noiDung = oChatInput.value.trim();

        if (!noiDung) return;

        themTinNhanChatbot(noiDung, "nguoiDung");
        oChatInput.value = "";

        try {
            themTinNhanChatbot("Đang xử lý...", "bot");
            const response = await fetch("/api/chatbot", { method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin", body: JSON.stringify({ message: noiDung }) });
            const data = await response.json();
            const messages = document.getElementById("oChatMessages");
            if (messages.lastElementChild?.textContent.includes("Đang xử lý...")) messages.lastElementChild.remove();
            themTinNhanChatbot(response.ok ? (data.answer || "AI không trả về câu trả lời.") : (data.message || "Có lỗi xảy ra khi kết nối với chatbot."), "bot");
        } catch (error) {
            console.error("Lỗi chatbot:", error);
            themTinNhanChatbot("Không thể kết nối đến máy chủ chatbot.", "bot");
        }

    }

</script>
<script src="~/js/chatbot-history.js" asp-append-version="true"></script>
</body>

</html>