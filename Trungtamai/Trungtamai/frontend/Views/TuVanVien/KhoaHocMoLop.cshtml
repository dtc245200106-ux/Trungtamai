@{
    Layout = null;
    var hoTen = ViewBag.HoTen ?? "Tư vấn viên";
    var dsNgonNgu = ViewBag.DsNgonNgu as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khóa học đang mở - Tư vấn viên | LinguistAI</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#091426",
                        "primary-container": "#1e293b",
                        "on-primary": "#ffffff",
                        background: "#f7f9fb",
                        surface: "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e5",
                        "outline-variant": "#c5c6cd",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#45474c",
                        secondary: "#006a61",
                        error: "#ba1a1a"
                    },
                    fontFamily: {
                        sans: ["Inter"]
                    },
                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem"
                    }
                }
            }
        };
    </script>

    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }

        .sidebar-item { transition: all 0.2s ease; }
        .sidebar-item:hover { background: #e6e8ea; }
        .sidebar-item.active { background: #091426; color: white; }

        .table-row { transition: background 0.15s ease; }
        .table-row:hover { background: #f7f9fb; }
    </style>
</head>

<body class="bg-background text-on-surface">

<div class="min-h-screen flex">

    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->
    <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">

        <!-- LOGO -->
        <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">school</span>
            </div>
            <div>
                <div class="font-bold text-primary text-lg">LinguistAI</div>
                <div class="text-xs text-on-surface-variant">Tư vấn viên</div>
            </div>
        </div>

        <!-- MENU (chỉ còn 1 mục) -->
        <nav class="flex-1 px-3 py-5 space-y-1">
            <a asp-controller="TuVanVien" asp-action="KhoaHocMoLop"
               class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
                <span class="material-symbols-outlined">menu_book</span>
                Khóa học đang mở
            </a>
        </nav>

        <!-- USER / LOGOUT -->
        <div class="border-t border-surface-variant p-4">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
                    @(hoTen.ToString().Substring(0, 1).ToUpper())
                </div>
                <div class="min-w-0">
                    <div class="font-medium text-sm truncate">@hoTen</div>
                    <div class="text-xs text-on-surface-variant">Tư vấn viên</div>
                </div>
            </div>
            
        </div>
    </aside>

    <!-- ================================================= -->
    <!-- MAIN -->
    <!-- ================================================= -->
    <main class="ml-[250px] flex-1 min-h-screen">

        <!-- TOPBAR -->
        <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8">
            <div>
                <h1 class="text-xl font-semibold text-primary">Khóa học đang mở</h1>
                <p class="text-sm text-on-surface-variant mt-1">
                    Chọn ngôn ngữ → chọn khóa học → xem các lớp đang mở
                </p>
            </div>
            <div class="flex items-center gap-4">
                <a asp-controller="Account" asp-action="Logout"
                   class="flex items-center gap-2 px-4 py-2 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
                    <span class="material-symbols-outlined text-[20px]">logout</span>
                    Đăng xuất
                </a>
            </div>
        </header>

        <!-- CONTENT -->
        <div class="p-8">

            <!-- Bước 1: Chọn ngôn ngữ -->
            <div class="bg-white rounded-xl border border-outline-variant p-6 mb-6">
                <h3 class="font-semibold text-primary mb-1">1. Chọn ngôn ngữ</h3>
                <p class="text-sm text-on-surface-variant mb-4">Chọn ngôn ngữ bạn muốn tư vấn</p>

                <select id="selNgonNgu"
        class="w-full max-w-md border border-outline-variant rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
    <option value="">-- Chọn ngôn ngữ --</option>
    @foreach (var nn in dsNgonNgu)
    {
        <option value="@nn">@nn</option>
    }
</select>
            </div>

            <!-- Bước 2: Chọn khóa học -->
            <div id="oKhoaHoc" class="bg-white rounded-xl border border-outline-variant p-6 mb-6 hidden">
                <h3 class="font-semibold text-primary mb-1">2. Chọn khóa học</h3>
                <p class="text-sm text-on-surface-variant mb-4">Danh sách khóa học thuộc ngôn ngữ đã chọn</p>

                <select id="selKhoaHoc"
                        class="w-full max-w-md border border-outline-variant rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">-- Chọn khóa học --</option>
                </select>
            </div>

            <!-- Bước 3: Danh sách lớp đang mở -->
            <div id="oDanhSachLop" class="bg-white rounded-xl border border-outline-variant hidden">
                <div class="p-6 border-b border-surface-variant">
                    <h3 class="font-semibold text-primary">3. Các lớp học đang mở</h3>
                    <p class="text-sm text-on-surface-variant mt-1">
                        Các lớp chưa kết thúc của khóa học đã chọn
                    </p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-surface-variant text-left">
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Tên lớp</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Trạng thái</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Ngày khai giảng</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Sĩ số</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Tiến độ (số buổi)</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Học phí</th>
                            </tr>
                        </thead>
                        <tbody id="thanBangLop">
                        </tbody>
                    </table>
                </div>

                <!-- Empty state -->
                <div id="oRongLop" class="hidden px-6 py-12 text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-5xl text-outline-variant">school</span>
                    <div class="mt-3 text-sm font-medium">Không có lớp nào đang mở</div>
                    <div class="text-xs mt-1">Khóa học này hiện chưa có lớp đang mở hoặc sắp khai giảng</div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    const selNgonNgu = document.getElementById("selNgonNgu");
    const selKhoaHoc = document.getElementById("selKhoaHoc");
    const oKhoaHoc = document.getElementById("oKhoaHoc");
    const oDanhSachLop = document.getElementById("oDanhSachLop");
    const thanBangLop = document.getElementById("thanBangLop");
    const oRongLop = document.getElementById("oRongLop");

    // 1. Chọn ngôn ngữ → load danh sách khóa học
    selNgonNgu.addEventListener("change", async function () {
        const ngonNgu = this.value;

        // Reset các bước sau
        selKhoaHoc.innerHTML = '<option value="">-- Chọn khóa học --</option>';
        oDanhSachLop.classList.add("hidden");
        oKhoaHoc.classList.add("hidden");
        thanBangLop.innerHTML = "";

        if (!ngonNgu) return;

        try {
            const res = await fetch(`/TuVanVien/LayKhoaHocTheoNgonNgu?ngonNgu=${encodeURIComponent(ngonNgu)}`);
            const data = await res.json();

            if (data.length === 0) {
                selKhoaHoc.innerHTML = '<option value="">Không có khóa học nào</option>';
            } else {
                data.forEach(kh => {
                    const opt = document.createElement("option");
                    opt.value = kh.id;
                    opt.textContent = kh.tenKhoaHoc;
                    selKhoaHoc.appendChild(opt);
                });
            }

            oKhoaHoc.classList.remove("hidden");
        } catch (err) {
            console.error("Lỗi tải khóa học:", err);
            alert("Không thể tải danh sách khóa học. Vui lòng thử lại.");
        }
    });

    // 2. Chọn khóa học → load danh sách lớp đang mở
    selKhoaHoc.addEventListener("change", async function () {
        const khoaHocId = this.value;

        oDanhSachLop.classList.add("hidden");
        thanBangLop.innerHTML = "";
        oRongLop.classList.add("hidden");

        if (!khoaHocId) return;

        try {
            const res = await fetch(`/TuVanVien/LayLopTheoKhoaHoc?khoaHocId=${khoaHocId}`);
            const data = await res.json();

            oDanhSachLop.classList.remove("hidden");

            if (data.length === 0) {
                oRongLop.classList.remove("hidden");
                return;
            }

            data.forEach(lop => {
                const tr = document.createElement("tr");
                tr.className = "table-row border-b border-surface-variant";

                const ngayKG = lop.ngayKhaiGiang
                    ? new Date(lop.ngayKhaiGiang).toLocaleDateString("vi-VN")
                    : "Chưa có";

                const siSo = `${lop.siSoHienTai ?? 0}/${lop.siSoToiDa ?? 0}`;

                const soBuoiDaHoc = lop.soBuoiDaHoc ?? 0;
                const hocPhi = (lop.hocPhi ?? 0).toLocaleString("vi-VN") + " đ";
                const tongSoBuoi = lop.tongSoBuoi ?? 0;
                const phanTramTienDo = tongSoBuoi > 0
                    ? Math.min(100, Math.round(soBuoiDaHoc / tongSoBuoi * 100))
                    : 0;

                tr.innerHTML = `
    <td class="px-6 py-4 font-medium text-primary">${lop.tenLop}</td>
    <td class="px-6 py-4">
        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-secondary/10 text-secondary">
            ${lop.trangThai}
        </span>
    </td>
    <td class="px-6 py-4 text-on-surface-variant">${ngayKG}</td>
    <td class="px-6 py-4 text-on-surface-variant">${siSo}</td>
    <td class="px-6 py-4">
        <div class="flex items-center gap-2">
            <span class="text-on-surface-variant whitespace-nowrap">${soBuoiDaHoc}/${tongSoBuoi} buổi</span>
                    <div class="w-24 h-1.5 rounded-full bg-surface-container-high overflow-hidden shrink-0">
            <div class="h-full bg-secondary" style="width: ${phanTramTienDo}%"></div>
        </div>
    </div>
</td>
<td class="px-6 py-4 font-medium text-primary whitespace-nowrap">${hocPhi}</td>
`;
                thanBangLop.appendChild(tr);
            });
        } catch (err) {
            console.error("Lỗi tải lớp học:", err);
            alert("Không thể tải danh sách lớp. Vui lòng thử lại.");
        }
    });

    
</script>
<!-- ================================================= -->
<!-- CHATBOT NỔI (GÓC DƯỚI BÊN PHẢI) -->
<!-- ================================================= -->

<div id="oChatbotPanel"
     class="hidden fixed bottom-24 right-6 z-50 w-[360px] max-w-[92vw] h-[480px] max-h-[75vh] bg-white rounded-xl border border-outline-variant shadow-2xl flex flex-col overflow-hidden">

    <div class="bg-primary text-white px-4 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
            </div>
            <div>
                <div class="text-sm font-semibold">Trợ lý AI</div>
                <div class="text-xs text-white/70">Luôn sẵn sàng hỗ trợ</div>
            </div>
        </div>
        <button onclick="dongChatbot()"
                class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/10 transition">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div id="oChatMessages"
         class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 bg-surface">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                Xin chào! Tôi có thể giúp gì cho bạn hôm nay?
            </div>
        </div>
    </div>

    <form onsubmit="guiTinNhanChatbot(event)"
          class="border-t border-surface-variant p-3 flex items-center gap-2 shrink-0 bg-white">
        <input id="oChatInput"
               type="text"
               autocomplete="off"
               placeholder="Nhập câu hỏi của bạn..."
               class="flex-1 rounded-lg border border-outline-variant px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
        <button type="submit"
                class="w-10 h-10 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center hover:opacity-90 transition">
            <span class="material-symbols-outlined text-[20px]">send</span>
        </button>
    </form>

</div>

<button id="oChatbotToggle"
        onclick="moChatbot()"
        class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[26px]">
        smart_toy
    </span>
</button>

<script>
    function moChatbot() {
        document.getElementById("oChatbotPanel").classList.remove("hidden");
        document.getElementById("oChatbotToggle").classList.add("hidden");
        document.getElementById("oChatInput").focus();
    }

    function dongChatbot() {
        document.getElementById("oChatbotPanel").classList.add("hidden");
        document.getElementById("oChatbotToggle").classList.remove("hidden");
    }

    function themTinNhanChatbot(noiDung, nguoiGui) {
        const oChatMessages = document.getElementById("oChatMessages");
        const dong = document.createElement("div");

        if (nguoiGui === "nguoiDung") {
            dong.className = "flex items-start gap-2 justify-end";
            dong.innerHTML = `
                <div class="bg-primary text-white rounded-xl rounded-tr-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;
        } else {
            dong.className = "flex items-start gap-2";
            dong.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[16px]">smart_toy</span>
                </div>
                <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;
        }

        oChatMessages.appendChild(dong);
        oChatMessages.scrollTop = oChatMessages.scrollHeight;
    }

    async function guiTinNhanChatbot(su) {
        su.preventDefault();

        const oChatInput = document.getElementById("oChatInput");
        const noiDung = oChatInput.value.trim();

        if (!noiDung) return;

        themTinNhanChatbot(noiDung, "nguoiDung");
        oChatInput.value = "";

        try {
            themTinNhanChatbot("Đang xử lý...", "bot");
            const response = await fetch("/api/chatbot", { method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin", body: JSON.stringify({ message: noiDung }) });
            const data = await response.json();
            const messages = document.getElementById("oChatMessages");
            if (messages.lastElementChild?.textContent.includes("Đang xử lý...")) messages.lastElementChild.remove();
            themTinNhanChatbot(response.ok ? (data.answer || "AI không trả về câu trả lời.") : (data.message || "Có lỗi xảy ra khi kết nối với chatbot."), "bot");
        } catch (error) {
            console.error("Lỗi chatbot:", error);
            themTinNhanChatbot("Không thể kết nối đến máy chủ chatbot.", "bot");
        }
    }
</script>
<script src="~/js/chatbot-history.js" asp-append-version="true"></script>
</body>
</html>