@model List<Trungtamai.Models.GiaoVien>

@{
    Layout = null;

    var hoTen = ViewBag.HoTen ?? "Quản lý";
    var tongGiaoVien = ViewBag.TongGiaoVien ?? 0;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản lý Giáo viên - LinguistAI</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#091426",
                        "primary-container": "#1e293b",
                        "on-primary": "#ffffff",
                        background: "#f7f9fb",
                        surface: "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e5",
                        "outline-variant": "#c5c6cd",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#45474c",
                        secondary: "#006a61",
                        error: "#ba1a1a"
                    },
                    fontFamily: {
                        sans: ["Inter"]
                    },
                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem"
                    }
                }
            }
        };
    </script>

    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .sidebar-item { transition: all 0.2s ease; }
        .sidebar-item:hover { background: #e6e8ea; }
        .sidebar-item.active { background: #091426; color: white; }
        .stat-card { transition: all 0.2s ease; }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
        }
    </style>
</head>

<body class="bg-background text-on-surface">

    <div class="min-h-screen flex">

        <!-- SIDEBAR -->
        <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">
            <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">
                <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">
                    <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">school</span>
                </div>
                <div>
                    <div class="font-bold text-primary text-lg">LinguistAI</div>
                    <div class="text-xs text-on-surface-variant">Quản lý trung tâm</div>
                </div>
            </div>

            <nav class="flex-1 px-3 py-5 space-y-1">
                <a asp-controller="QuanLy" asp-action="Index" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">dashboard</span> Tổng quan
                </a>
                <a asp-controller="QuanLy" asp-action="HocVien" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">group</span> Học viên
                </a>
                <a asp-controller="QuanLy" asp-action="GiaoVien" class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
                    <span class="material-symbols-outlined">person</span> Giáo viên
                </a>
                <a asp-controller="QuanLy" asp-action="KhoaHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">menu_book</span> Khóa học
                </a>
                <a asp-controller="QuanLy" asp-action="LopHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">groups</span> Lớp học
                </a>
                <a asp-controller="QuanLy" asp-action="LichHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">calendar_month</span> Lịch học
                </a>
                <a asp-controller="QuanLy" asp-action="HocPhi" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">payments</span> Học phí
                </a>
                <a asp-controller="QuanLy" asp-action="KetQuaHocTap" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">assessment</span> Kết quả học tập
                </a>
                <a asp-controller="QuanLy" asp-action="ThongKe" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                    <span class="material-symbols-outlined">bar_chart</span> Thống kê
                </a>
            </nav>

            <div class="border-t border-surface-variant p-4">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
                        @(hoTen.ToString().Length > 0 ? hoTen.ToString().Substring(0, 1).ToUpper() : "Q")
                    </div>
                    <div class="min-w-0">
                        <div class="font-medium text-sm truncate">@hoTen</div>
                        <div class="text-xs text-on-surface-variant">Quản lý</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="ml-[250px] flex-1 min-h-screen">
            <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8 sticky top-0 z-10">
                <div>
                    <h1 class="text-2xl font-bold text-primary">Quản lý Giáo viên</h1>
                    <p class="text-sm text-on-surface-variant mt-0.5">Theo dõi và quản lý đội ngũ giảng viên</p>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" onclick="moModalThemGiaoVien()"
                            class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:opacity-90 transition">
                        <span class="material-symbols-outlined text-[20px]">person_add</span>
                        Thêm giáo viên
                    </button>
                    <a asp-controller="Account" asp-action="Logout"
                       class="flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
                        <span class="material-symbols-outlined text-[20px]">logout</span>
                        Đăng xuất
                    </a>
                </div>
            </header>

            <div class="p-8">
                @if (TempData["Success"] != null)
                {
                    <div class="mb-6 flex items-center gap-3 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700">
                        <span class="material-symbols-outlined">check_circle</span>
                        <span>@TempData["Success"]</span>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="mb-6 flex items-center gap-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700">
                        <span class="material-symbols-outlined">error</span>
                        <span>@TempData["Error"]</span>
                    </div>
                }

                <!-- STATISTIC -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">
                    <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                        <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary">group</span>
                        </div>
                        <div class="mt-5">
                            <div class="text-sm text-on-surface-variant">Tổng giáo viên</div>
                            <div class="text-3xl font-semibold text-primary mt-1">@tongGiaoVien</div>
                        </div>
                    </div>
                    <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                        <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary">school</span>
                        </div>
                        <div class="mt-5">
                            <div class="text-sm text-on-surface-variant">Giáo viên đang hiển thị</div>
                            <div id="soLuongHienThi" class="text-3xl font-semibold text-primary mt-1">@(Model?.Count ?? 0)</div>
                        </div>
                    </div>
                </div>

                <!-- SEARCH -->
                <div class="bg-white rounded-xl border border-outline-variant p-5 mb-6">
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
                        <input id="timKiemGiaoVien" type="text"
                               placeholder="Tìm theo mã, họ tên, email, số điện thoại, ngôn ngữ hoặc chuyên môn..."
                               class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-outline-variant bg-surface-container-low text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />
                    </div>
                </div>

                <!-- TABLE -->
                <div class="bg-white rounded-xl border border-outline-variant overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm">
                            <thead class="bg-surface-container-low text-on-surface-variant">
                                <tr>
                                    <th class="px-5 py-4 font-medium">Mã GV</th>
                                    <th class="px-5 py-4 font-medium">Họ và tên</th>
                                    <th class="px-5 py-4 font-medium">Email</th>
                                    <th class="px-5 py-4 font-medium">Số điện thoại</th>
                                    <th class="px-5 py-4 font-medium">Ngôn ngữ</th>
                                    <th class="px-5 py-4 font-medium">Chuyên môn</th>
                                    <th class="px-5 py-4 font-medium">Kinh nghiệm</th>
                                    <th class="px-5 py-4 font-medium text-right">Hành động</th>
                                </tr>
                            </thead>
                            <tbody id="danhSachGiaoVien">
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var giaoVien in Model)
                                    {
                                        var ten = giaoVien.HoTen ?? "";
                                        var vietTat = "GV";
                                        var cacTu = ten.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                        if (cacTu.Length >= 2)
                                        {
                                            vietTat = cacTu[0].Substring(0, 1) + cacTu[^1].Substring(0, 1);
                                        }
                                        else if (cacTu.Length == 1)
                                        {
                                            vietTat = cacTu[0].Substring(0, 1);
                                        }

                                        <tr class="dong-giao-vien border-t border-outline-variant hover:bg-surface-container-low">
                                            <td class="px-5 py-4">
                                                <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                                                    @giaoVien.MaGiaoVien
                                                </span>
                                            </td>
                                            <td class="px-5 py-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-10 h-10 rounded-full bg-primary/10 text-primary font-semibold flex items-center justify-center">
                                                        @vietTat.ToUpper()
                                                    </div>
                                                    <div class="font-medium text-on-surface">@giaoVien.HoTen</div>
                                                </div>
                                            </td>
                                            <td class="px-5 py-4 text-on-surface-variant">@giaoVien.Email</td>
                                            <td class="px-5 py-4 text-on-surface-variant">@giaoVien.SoDienThoai</td>
                                            <td class="px-5 py-4">@giaoVien.NgonNgu</td>
                                            <td class="px-5 py-4">@giaoVien.ChuyenMon</td>
                                            <td class="px-5 py-4">@giaoVien.KinhNghiem năm</td>
                                            <td class="px-5 py-4 text-right">
                                                <div class="flex items-center justify-end gap-3">
                                                    <button type="button"
                                                            onclick='xemGiaoVien(
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.HoTen)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.MaGiaoVien)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.Email)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.SoDienThoai)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.NgonNgu)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.ChuyenMon)),
                                                                @giaoVien.KinhNghiem
                                                            )'
                                                            class="text-sm font-medium text-primary hover:underline">
                                                        Xem
                                                    </button>
                                                    <button type="button"
                                                            onclick='moModalSuaGiaoVien(
                                                                @giaoVien.Id,
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.HoTen)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.Email)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.SoDienThoai)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.NgonNgu)),
                                                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.ChuyenMon)),
                                                                @giaoVien.KinhNghiem
                                                            )'
                                                            class="text-sm font-medium text-blue-600 hover:underline">
                                                        Sửa
                                                    </button>
                                                    <button type="button"
                                                            onclick='moModalXoaGiaoVien(@giaoVien.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(giaoVien.HoTen)))'
                                                            class="text-sm font-medium text-red-600 hover:underline">
                                                        Xóa
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="khongCoGiaoVien">
                                        <td colspan="8" class="px-6 py-10 text-center text-on-surface-variant">
                                            Chưa có giáo viên nào.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- ================= MODAL THÊM ================= -->
    <div id="modalThemGiaoVien" class="hidden fixed inset-0 z-[9999] bg-black/50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant sticky top-0 bg-white z-10">
                <div>
                    <h2 class="text-xl font-bold text-primary">Thêm giáo viên</h2>
                    <p class="text-sm text-on-surface-variant mt-1">Mã giáo viên sẽ được hệ thống tự động tạo.</p>
                </div>
                <button type="button" onclick="dongModalThemGiaoVien()"
                        class="w-9 h-9 rounded-lg hover:bg-surface-container flex items-center justify-center">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form asp-controller="QuanLy" asp-action="ThemGiaoVien" method="post" class="p-6">
                @Html.AntiForgeryToken()

                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Họ và tên</label>
                    <input type="text" name="hoTen" required placeholder="Nhập họ tên giáo viên"
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Email</label>
                    <input type="email" name="email" required placeholder="example@email.com"
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Số điện thoại</label>
                    <input type="tel" name="soDienThoai" required placeholder="Ví dụ: 0912345678"
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Ngôn ngữ</label>
                    <select name="ngonNgu" required class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                        <option value="">-- Chọn ngôn ngữ --</option>
                        <option value="Tiếng Anh">Tiếng Anh</option>
                        <option value="Tiếng Trung">Tiếng Trung</option>
                        <option value="Tiếng Nhật">Tiếng Nhật</option>
                        <option value="Tiếng Hàn">Tiếng Hàn</option>
                    </select>
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Chuyên môn</label>
                    <input type="text" name="chuyenMon" required placeholder="Ví dụ: IELTS, Giao tiếp..."
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-medium mb-2">Kinh nghiệm (năm)</label>
                    <input type="number" name="kinhNghiem" min="0" required placeholder="Ví dụ: 5"
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>

                <div class="flex justify-end gap-3">
                    <button type="button" onclick="dongModalThemGiaoVien()"
                            class="px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium hover:bg-surface-container">Hủy</button>
                    <button type="submit" class="px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:opacity-90 transition">Lưu giáo viên</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= MODAL SỬA ================= -->
    <div id="modalSuaGiaoVien" class="hidden fixed inset-0 z-[9999] bg-black/50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant sticky top-0 bg-white z-10">
                <div>
                    <h2 class="text-xl font-bold text-primary">Sửa giáo viên</h2>
                    <p class="text-sm text-on-surface-variant mt-1">Cập nhật thông tin giáo viên</p>
                </div>
                <button type="button" onclick="dongModalSuaGiaoVien()"
                        class="w-9 h-9 rounded-lg hover:bg-surface-container flex items-center justify-center">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form asp-controller="QuanLy" asp-action="SuaGiaoVien" method="post" class="p-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="suaId" />

                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Họ và tên</label>
                    <input type="text" name="hoTen" id="suaHoTen" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Email</label>
                    <input type="email" name="email" id="suaEmail" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Số điện thoại</label>
                    <input type="tel" name="soDienThoai" id="suaSoDienThoai" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Ngôn ngữ</label>
                    <select name="ngonNgu" id="suaNgonNgu" required
                            class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20">
                        <option value="">-- Chọn ngôn ngữ --</option>
                        <option value="Tiếng Anh">Tiếng Anh</option>
                        <option value="Tiếng Trung">Tiếng Trung</option>
                        <option value="Tiếng Nhật">Tiếng Nhật</option>
                        <option value="Tiếng Hàn">Tiếng Hàn</option>
                    </select>
                </div>
                <div class="mb-5">
                    <label class="block text-sm font-medium mb-2">Chuyên môn</label>
                    <input type="text" name="chuyenMon" id="suaChuyenMon" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-medium mb-2">Kinh nghiệm (năm)</label>
                    <input type="number" name="kinhNghiem" id="suaKinhNghiem" min="0" required
                           class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>

                <div class="flex justify-end gap-3">
                    <button type="button" onclick="dongModalSuaGiaoVien()"
                            class="px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium hover:bg-surface-container">Hủy</button>
                    <button type="submit" class="px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:opacity-90 transition">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= MODAL XEM ================= -->
    <div id="modalXemGiaoVien" class="hidden fixed inset-0 z-[9999] bg-black/50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg">
            <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant">
                <h2 class="text-xl font-bold text-primary">Thông tin giáo viên</h2>
                <button type="button" onclick="dongModalXemGiaoVien()"
                        class="w-9 h-9 rounded-lg hover:bg-surface-container flex items-center justify-center">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="p-6">
                <div class="flex items-center gap-4 mb-6">
                    <div id="avatarGiaoVien" class="w-16 h-16 rounded-full bg-primary text-white text-xl font-bold flex items-center justify-center">GV</div>
                    <div>
                        <div id="xemHoTen" class="text-xl font-semibold text-primary"></div>
                        <div id="xemMaGiaoVien" class="text-sm text-on-surface-variant mt-1"></div>
                    </div>
                </div>

                <div class="border border-outline-variant rounded-lg divide-y">
                    <div class="p-4">
                        <div class="text-xs text-on-surface-variant mb-1">Email</div>
                        <div id="xemEmail" class="font-medium"></div>
                    </div>
                    <div class="p-4">
                        <div class="text-xs text-on-surface-variant mb-1">Số điện thoại</div>
                        <div id="xemSoDienThoai" class="font-medium"></div>
                    </div>
                    <div class="p-4">
                        <div class="text-xs text-on-surface-variant mb-1">Ngôn ngữ</div>
                        <div id="xemNgonNgu" class="font-medium"></div>
                    </div>
                    <div class="p-4">
                        <div class="text-xs text-on-surface-variant mb-1">Chuyên môn</div>
                        <div id="xemChuyenMon" class="font-medium"></div>
                    </div>
                    <div class="p-4">
                        <div class="text-xs text-on-surface-variant mb-1">Kinh nghiệm</div>
                        <div id="xemKinhNghiem" class="font-medium"></div>
                    </div>
                </div>

                <div class="flex justify-end mt-6">
                    <button type="button" onclick="dongModalXemGiaoVien()"
                            class="px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-medium">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= MODAL XÓA ================= -->
    <div id="modalXoaGiaoVien" class="hidden fixed inset-0 z-[9999] bg-black/50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md">
            <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center">
                        <span class="material-symbols-outlined text-red-600">warning</span>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-primary">Xác nhận xóa</h2>
                        <p class="text-sm text-on-surface-variant mt-1">Bạn có chắc muốn xóa giáo viên này?</p>
                    </div>
                </div>

                <p class="text-sm mb-6">
                    Giáo viên: <strong id="tenGiaoVienXoa"></strong>
                </p>

                <form asp-controller="QuanLy" asp-action="XoaGiaoVien" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="xoaId" />

                    <div class="flex justify-end gap-3">
                        <button type="button" onclick="dongModalXoaGiaoVien()"
                                class="px-4 py-2.5 rounded-lg border border-outline-variant text-sm font-medium hover:bg-surface-container">
                            Hủy
                        </button>
                        <button type="submit"
                                class="px-5 py-2.5 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition">
                            Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // ===== THÊM =====
        function moModalThemGiaoVien() {
            document.getElementById("modalThemGiaoVien").classList.remove("hidden");
            document.body.classList.add("overflow-hidden");
        }
        function dongModalThemGiaoVien() {
            document.getElementById("modalThemGiaoVien").classList.add("hidden");
            document.body.classList.remove("overflow-hidden");
        }

        // ===== SỬA =====
        function moModalSuaGiaoVien(id, hoTen, email, soDienThoai, ngonNgu, chuyenMon, kinhNghiem) {
            document.getElementById("suaId").value = id;
            document.getElementById("suaHoTen").value = hoTen || "";
            document.getElementById("suaEmail").value = email || "";
            document.getElementById("suaSoDienThoai").value = soDienThoai || "";
            document.getElementById("suaNgonNgu").value = ngonNgu || "";
            document.getElementById("suaChuyenMon").value = chuyenMon || "";
            document.getElementById("suaKinhNghiem").value = kinhNghiem ?? 0;

            document.getElementById("modalSuaGiaoVien").classList.remove("hidden");
            document.body.classList.add("overflow-hidden");
        }
        function dongModalSuaGiaoVien() {
            document.getElementById("modalSuaGiaoVien").classList.add("hidden");
            document.body.classList.remove("overflow-hidden");
        }

        // ===== XEM =====
        function xemGiaoVien(hoTen, maGiaoVien, email, soDienThoai, ngonNgu, chuyenMon, kinhNghiem) {
            document.getElementById("xemHoTen").textContent = hoTen || "";
            document.getElementById("xemMaGiaoVien").textContent = "Mã giáo viên: " + (maGiaoVien || "");
            document.getElementById("xemEmail").textContent = email || "";
            document.getElementById("xemSoDienThoai").textContent = soDienThoai || "";
            document.getElementById("xemNgonNgu").textContent = ngonNgu || "";
            document.getElementById("xemChuyenMon").textContent = chuyenMon || "";
            document.getElementById("xemKinhNghiem").textContent = (kinhNghiem ?? 0) + " năm";

            let vietTat = "GV";
            if (hoTen) {
                const cacTu = hoTen.trim().split(/\s+/);
                if (cacTu.length >= 2) {
                    vietTat = cacTu[0].charAt(0) + cacTu[cacTu.length - 1].charAt(0);
                } else if (cacTu.length === 1) {
                    vietTat = cacTu[0].charAt(0);
                }
            }
            document.getElementById("avatarGiaoVien").textContent = vietTat.toUpperCase();

            document.getElementById("modalXemGiaoVien").classList.remove("hidden");
            document.body.classList.add("overflow-hidden");
        }
        function dongModalXemGiaoVien() {
            document.getElementById("modalXemGiaoVien").classList.add("hidden");
            document.body.classList.remove("overflow-hidden");
        }

        // ===== XÓA =====
        function moModalXoaGiaoVien(id, ten) {
            document.getElementById("xoaId").value = id;
            document.getElementById("tenGiaoVienXoa").textContent = ten || "";
            document.getElementById("modalXoaGiaoVien").classList.remove("hidden");
            document.body.classList.add("overflow-hidden");
        }
        function dongModalXoaGiaoVien() {
            document.getElementById("modalXoaGiaoVien").classList.add("hidden");
            document.body.classList.remove("overflow-hidden");
        }

        // ===== TÌM KIẾM =====
        const timKiemGiaoVien = document.getElementById("timKiemGiaoVien");
        if (timKiemGiaoVien) {
            timKiemGiaoVien.addEventListener("input", function () {
                const tuKhoa = this.value.toLowerCase().trim();
                const danhSach = document.querySelectorAll(".dong-giao-vien");
                let soLuong = 0;
                danhSach.forEach(function (dong) {
                    if (dong.innerText.toLowerCase().includes(tuKhoa)) {
                        dong.style.display = "";
                        soLuong++;
                    } else {
                        dong.style.display = "none";
                    }
                });
                const soLuongHienThi = document.getElementById("soLuongHienThi");
                if (soLuongHienThi) soLuongHienThi.textContent = soLuong;
            });
        }

        // ===== ĐÓNG MODAL KHI CLICK NGOÀI / ESC =====
        window.addEventListener("click", function (event) {
            ["modalThemGiaoVien", "modalSuaGiaoVien", "modalXemGiaoVien", "modalXoaGiaoVien"].forEach(function (id) {
                const modal = document.getElementById(id);
                if (event.target === modal) {
                    modal.classList.add("hidden");
                    document.body.classList.remove("overflow-hidden");
                }
            });
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                ["modalThemGiaoVien", "modalSuaGiaoVien", "modalXemGiaoVien", "modalXoaGiaoVien"].forEach(function (id) {
                    document.getElementById(id).classList.add("hidden");
                });
                document.body.classList.remove("overflow-hidden");
            }
        });
    </script>
<!-- ================================================= -->
<!-- CHATBOT NỔI (GÓC DƯỚI BÊN PHẢI) -->
<!-- ================================================= -->

<div id="oChatbotPanel"
     class="hidden fixed bottom-24 right-6 z-50 w-[360px] max-w-[92vw] h-[480px] max-h-[75vh] bg-white rounded-xl border border-outline-variant shadow-2xl flex flex-col overflow-hidden">

    <div class="bg-primary text-white px-4 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
            </div>
            <div>
                <div class="text-sm font-semibold">Trợ lý AI</div>
                <div class="text-xs text-white/70">Luôn sẵn sàng hỗ trợ</div>
            </div>
        </div>
        <button type="button" onclick="dongChatbot()"
                class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/10 transition">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div id="oChatMessages"
         class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 bg-surface">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                Xin chào! Tôi có thể giúp gì cho bạn hôm nay?
            </div>
        </div>
    </div>

    <form onsubmit="guiTinNhanChatbot(event)"
          class="border-t border-surface-variant p-3 flex items-center gap-2 shrink-0 bg-white">
        <input id="oChatInput"
               type="text"
               autocomplete="off"
               placeholder="Nhập câu hỏi của bạn..."
               class="flex-1 rounded-lg border border-outline-variant px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
        <button type="submit"
                class="w-10 h-10 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center hover:opacity-90 transition">
            <span class="material-symbols-outlined text-[20px]">send</span>
        </button>
    </form>
</div>

<!-- NÚT MỞ CHATBOT -->
<button id="oChatbotToggle"
        type="button"
        onclick="moChatbot()"
        class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[26px]">smart_toy</span>
</button>

<script>
    function moChatbot() {
        document.getElementById("oChatbotPanel").classList.remove("hidden");
        document.getElementById("oChatbotToggle").classList.add("hidden");
        document.getElementById("oChatInput").focus();
    }

    function dongChatbot() {
        document.getElementById("oChatbotPanel").classList.add("hidden");
        document.getElementById("oChatbotToggle").classList.remove("hidden");
    }

    function themTinNhanChatbot(noiDung, nguoiGui) {
        const oChatMessages = document.getElementById("oChatMessages");
        const dong = document.createElement("div");

        if (nguoiGui === "nguoiDung") {
            dong.className = "flex items-start gap-2 justify-end";
            dong.innerHTML = `
                <div class="bg-primary text-white rounded-xl rounded-tr-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;
        } else {
            dong.className = "flex items-start gap-2";
            dong.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[16px]">smart_toy</span>
                </div>
                <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>
            `;
        }

        oChatMessages.appendChild(dong);
        oChatMessages.scrollTop = oChatMessages.scrollHeight;
    }

    async function guiTinNhanChatbot(su) {
        su.preventDefault();

        const oChatInput = document.getElementById("oChatInput");
        const noiDung = oChatInput.value.trim();
        if (!noiDung) return;

        themTinNhanChatbot(noiDung, "nguoiDung");
        oChatInput.value = "";

        // Tạm thời trả lời mẫu (sau này gắn API AI)
        try {
            themTinNhanChatbot("Đang xử lý...", "bot");
            const response = await fetch("/api/chatbot", { method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin", body: JSON.stringify({ message: noiDung }) });
            const data = await response.json();
            const messages = document.getElementById("oChatMessages");
            if (messages.lastElementChild?.textContent.includes("Đang xử lý...")) messages.lastElementChild.remove();
            themTinNhanChatbot(response.ok ? (data.answer || "AI không trả về câu trả lời.") : (data.message || "Có lỗi xảy ra khi kết nối với chatbot."), "bot");
        } catch (error) {
            console.error("Lỗi chatbot:", error);
            themTinNhanChatbot("Không thể kết nối đến máy chủ chatbot.", "bot");
        }
    }
</script>
<script src="~/js/chatbot-history.js" asp-append-version="true"></script>
</body>
</html>