@{
    Layout = null;
    var hoTen = ViewBag.HoTen ?? "Học viên";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Học viên - LinguistAI</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#091426",
                        "primary-container": "#1e293b",
                        "on-primary": "#ffffff",
                        background: "#f7f9fb",
                        surface: "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e5",
                        "outline-variant": "#c5c6cd",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#45474c",
                        secondary: "#006a61",
                        error: "#ba1a1a"
                    },
                    fontFamily: {
                        sans: ["Inter"]
                    },
                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem"
                    }
                }
            }
        };
    </script>

    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .sidebar-item { transition: all 0.2s ease; }
        .sidebar-item:hover { background: #e6e8ea; }
        .sidebar-item.active { background: #091426; color: white; }
        .stat-card { transition: all 0.2s ease; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
        .table-row { transition: background 0.15s ease; }
        .table-row:hover { background: #f7f9fb; }
    </style>
</head>
<body class="bg-background text-on-surface">



<div class="min-h-screen flex">

    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->
    <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">

        <!-- LOGO -->
        <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">school</span>
            </div>
            <div>
                <div class="font-bold text-primary text-lg">LinguistAI</div>
                <div class="text-xs text-on-surface-variant">Học viên</div>
            </div>
        </div>

        <!-- MENU -->
        <nav class="flex-1 px-3 py-5 space-y-1">
            <a asp-controller="HocVien" asp-action="Index"
               class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
                <span class="material-symbols-outlined">dashboard</span>
                Tổng quan
            </a>

            <a asp-controller="HocVien" asp-action="LopCuaToi" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">groups</span>
    Lớp học của tôi
</a>

            <a asp-controller="HocVien" asp-action="LichHoc" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">calendar_month</span>
    Lịch học
</a>

            

            

            
        </nav>

        <!-- USER -->
        <div class="border-t border-surface-variant p-4">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
                    @(hoTen.ToString().Substring(0, 1).ToUpper())
                </div>
                <div class="min-w-0">
                    <div class="font-medium text-sm truncate">@hoTen</div>
                    <div class="text-xs text-on-surface-variant">Học viên</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ================================================= -->
    <!-- MAIN -->
    <!-- ================================================= -->
    <main class="ml-[250px] flex-1 min-h-screen">

        <!-- TOPBAR -->
        <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8">
            <div>
                <h1 class="text-xl font-semibold text-primary">Tổng quan</h1>
                <p class="text-sm text-on-surface-variant mt-1">
                    Xin chào @hoTen, chúc bạn học tập thật hiệu quả
                </p>
            </div>

            <div class="flex items-center gap-4">
                <a asp-controller="Account" asp-action="Logout"
                   class="flex items-center gap-2 px-4 py-2 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
                    <span class="material-symbols-outlined text-[20px]">logout</span>
                    Đăng xuất
                </a>
            </div>
        </header>

        <!-- CONTENT -->
        <div class="p-8">

            <!-- THỐNG KÊ -->
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">groups</span>
                    </div>
                    <div class="mt-5">
                        <div class="text-sm text-on-surface-variant">Lớp đang học</div>
                        <div id="statLop" class="text-3xl font-semibold text-primary mt-1">0</div>
                    </div>
                </div>

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-secondary">today</span>
                    </div>
                    <div class="mt-5">
                        <div class="text-sm text-on-surface-variant">Buổi học hôm nay</div>
                        <div id="statBuoiHomNay" class="text-3xl font-semibold text-primary mt-1">0</div>
                    </div>
                </div>

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">military_tech</span>
                    </div>
                    <div class="mt-5">
                        <div class="text-sm text-on-surface-variant">Điểm trung bình</div>
                        <div id="statDiemTB" class="text-3xl font-semibold text-primary mt-1">--</div>
                    </div>
                </div>

                <div class="stat-card bg-white rounded-xl border border-outline-variant p-5">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-error">payments</span>
                    </div>
                    <div class="mt-5">
                        <div class="text-sm text-on-surface-variant">Học phí còn nợ</div>
                        <div id="statHocPhi" class="text-3xl font-semibold text-primary mt-1">0đ</div>
                    </div>
                </div>
            </div>

            <!-- LỊCH HỌC HÔM NAY -->
            <div class="bg-white rounded-xl border border-outline-variant mb-8">
                <div class="p-6 border-b border-surface-variant">
                    <h3 class="font-semibold text-primary">Lịch học hôm nay</h3>
                    <p class="text-sm text-on-surface-variant mt-1">Các buổi học của bạn trong ngày</p>
                </div>

                <div id="dsLichHoc" class="divide-y divide-surface-variant"></div>

                <div id="oRongLich" class="hidden px-6 py-10 text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-4xl text-outline-variant">event_available</span>
                    <div class="mt-2 text-sm">Hôm nay bạn không có lịch học</div>
                </div>
            </div>

            <!-- LỚP HỌC ĐANG THAM GIA -->
            <div class="bg-white rounded-xl border border-outline-variant">
                <div class="p-6 border-b border-surface-variant">
                    <h3 class="font-semibold text-primary">Lớp học đang tham gia</h3>
                    <p class="text-sm text-on-surface-variant mt-1">Danh sách các lớp bạn đang theo học</p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-surface-variant text-left">
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Mã lớp</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Tên lớp</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Giáo viên</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Tiến độ</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Lịch học</th>
                                <th class="px-6 py-4 font-medium text-on-surface-variant">Trạng thái</th>
                
                            </tr>
                        </thead>
                        <tbody id="thanBangLop"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- ================================================= -->
<!-- CHATBOT NỔI -->
<!-- ================================================= -->
<div id="oChatbotPanel"
     class="hidden fixed bottom-24 right-6 z-50 w-[360px] max-w-[92vw] h-[480px] max-h-[75vh] bg-white rounded-xl border border-outline-variant shadow-2xl flex flex-col overflow-hidden">

    <div class="bg-primary text-white px-4 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
            </div>
            <div>
                <div class="text-sm font-semibold">Trợ lý AI</div>
                <div class="text-xs text-white/70">Luôn sẵn sàng hỗ trợ</div>
            </div>
        </div>
        <button onclick="dongChatbot()" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/10 transition">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div id="oChatMessages" class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 bg-surface">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                Xin chào! Tôi có thể giúp gì cho bạn hôm nay?
            </div>
        </div>
    </div>

    <form onsubmit="guiTinNhanChatbot(event)" class="border-t border-surface-variant p-3 flex items-center gap-2 shrink-0 bg-white">
        <input id="oChatInput" type="text" autocomplete="off" placeholder="Nhập câu hỏi của bạn..."
               class="flex-1 rounded-lg border border-outline-variant px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
        <button type="submit" class="w-10 h-10 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center hover:opacity-90 transition">
            <span class="material-symbols-outlined text-[20px]">send</span>
        </button>
    </form>
</div>

<button id="oChatbotToggle" onclick="moChatbot()"
        class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[26px]">smart_toy</span>
</button>

<!-- ================================================= -->
<!-- SCRIPT CHÍNH -->
<!-- ================================================= -->
<script>
    // Dữ liệu từ Controller
    const lichHocHomNay = @Html.Raw(ViewBag.LichHocHomNayJson ?? "[]");
    const dsLopHocCuaToi = @Html.Raw(ViewBag.DanhSachLopJson ?? "[]");
    const diemTrungBinh = "@ViewBag.DiemTrungBinh";
    const hocPhiConNo = @Html.Raw(ViewBag.HocPhiConNo ?? 0);

    // ===================== RENDER THỐNG KÊ =====================
    function renderThongKe() {
        document.getElementById("statLop").textContent = dsLopHocCuaToi.length;
        document.getElementById("statBuoiHomNay").textContent = lichHocHomNay.length;
        document.getElementById("statDiemTB").textContent = diemTrungBinh;
        document.getElementById("statHocPhi").textContent =
            Number(hocPhiConNo).toLocaleString("vi-VN") + "đ";
    }

    // ===================== RENDER LỊCH HỌC HÔM NAY =====================
    function renderLichHoc() {
        const dsLichHoc = document.getElementById("dsLichHoc");
        const oRongLich = document.getElementById("oRongLich");

        dsLichHoc.innerHTML = "";

        if (lichHocHomNay.length === 0) {
            oRongLich.classList.remove("hidden");
            return;
        }

        oRongLich.classList.add("hidden");

        lichHocHomNay.forEach(buoi => {
            const dong = document.createElement("div");
            dong.className = "px-6 py-4 flex items-center justify-between";
            dong.innerHTML = `
                <div class="flex items-center gap-4">
                    <div class="w-11 h-11 rounded-lg bg-surface-container flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-primary">schedule</span>
                    </div>
                    <div>
                        <div class="font-medium text-on-surface">${buoi.lop}</div>
                        <div class="text-xs text-on-surface-variant mt-0.5">${buoi.gio} · ${buoi.phong}</div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-secondary/10 text-secondary">
                        ${buoi.trangThai}
                    </span>
                </div>
            `;
            dsLichHoc.appendChild(dong);
        });
    }

    // ===================== RENDER BẢNG LỚP =====================
    function mauTrangThaiLop(trangThai) {
        if (trangThai === "Đang học") return "bg-secondary/10 text-secondary";
        if (trangThai === "Sắp khai giảng") return "bg-amber-50 text-amber-700";
        return "bg-surface-container text-on-surface-variant";
    }

    function renderBangLop() {
        const tbody = document.getElementById("thanBangLop");
        tbody.innerHTML = "";

        if (dsLopHocCuaToi.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="px-6 py-10 text-center text-on-surface-variant">
                        Bạn chưa tham gia lớp nào
                    </td>
                </tr>`;
            return;
        }

        dsLopHocCuaToi.forEach(lop => {
            const tr = document.createElement("tr");
            tr.className = "table-row border-b border-surface-variant";
            tr.innerHTML = `
                <td class="px-6 py-4">${lop.ma || ""}</td>
                <td class="px-6 py-4 font-medium">${lop.ten || ""}</td>
                <td class="px-6 py-4">${lop.giaoVien || ""}</td>
                <td class="px-6 py-4">${lop.tienDo || ""}</td>
                <td class="px-6 py-4">${lop.lich || ""}</td>
                <td class="px-6 py-4">
    <span class="px-2.5 py-1 rounded-full text-xs font-medium ${mauTrangThaiLop(lop.trangThai)}">
        ${lop.trangThai || ""}
    </span>
</td>
            `;
            tbody.appendChild(tr);
        });
    }

    

    // ===================== CHATBOT =====================
    function moChatbot() {
        document.getElementById("oChatbotPanel").classList.remove("hidden");
        document.getElementById("oChatbotToggle").classList.add("hidden");
        document.getElementById("oChatInput").focus();
    }

    function dongChatbot() {
        document.getElementById("oChatbotPanel").classList.add("hidden");
        document.getElementById("oChatbotToggle").classList.remove("hidden");
    }

    function themTinNhanChatbot(noiDung, nguoiGui) {
        const oChatMessages = document.getElementById("oChatMessages");
        const dong = document.createElement("div");

        if (nguoiGui === "nguoiDung") {
            dong.className = "flex items-start gap-2 justify-end";
            dong.innerHTML = `
                <div class="bg-primary text-white rounded-xl rounded-tr-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>`;
        } else {
            dong.className = "flex items-start gap-2";
            dong.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[16px]">smart_toy</span>
                </div>
                <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                    ${noiDung}
                </div>`;
        }

        oChatMessages.appendChild(dong);
        oChatMessages.scrollTop = oChatMessages.scrollHeight;
    }

    async function guiTinNhanChatbot(e) {
    e.preventDefault();

    const oChatInput = document.getElementById("oChatInput");
    const noiDung = oChatInput.value.trim();

    if (!noiDung) return;

    // Hiển thị câu hỏi của người dùng
    themTinNhanChatbot(noiDung, "nguoiDung");

    // Xóa ô nhập
    oChatInput.value = "";

    try {
        // Hiển thị trạng thái đang trả lời
        themTinNhanChatbot("Đang xử lý...", "bot");

        const response = await fetch("/api/chatbot", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            credentials: "same-origin",
            body: JSON.stringify({
                message: noiDung
            })
        });

        const data = await response.json();

        // Xóa tin nhắn "Đang xử lý..."
        const messages = document.getElementById("oChatMessages");
        const tinNhanCuoi = messages.lastElementChild;

        if (tinNhanCuoi && tinNhanCuoi.textContent.includes("Đang xử lý...")) {
            tinNhanCuoi.remove();
        }

        if (!response.ok) {
            themTinNhanChatbot(
                data.message || "Có lỗi xảy ra khi kết nối với chatbot.",
                "bot"
            );
            return;
        }

        // Hiển thị câu trả lời thật từ Gemini
        themTinNhanChatbot(
            data.answer || "AI không trả về câu trả lời.",
            "bot"
        );

    } catch (error) {
        console.error("Lỗi chatbot:", error);

        themTinNhanChatbot(
            "Không thể kết nối đến máy chủ chatbot.",
            "bot"
        );
    }
}

    // ===================== KHỞI TẠO =====================
    renderThongKe();
    renderLichHoc();
    renderBangLop();
</script>

<script src="~/js/chatbot-history.js" asp-append-version="true"></script>
</body>
</html>