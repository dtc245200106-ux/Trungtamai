@{
    Layout = null;
    var hoTen = ViewBag.HoTen ?? "Học viên";
    var lopId = ViewBag.LopId;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lớp học của tôi - LinguistAI</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#091426",
                        "primary-container": "#1e293b",
                        "on-primary": "#ffffff",
                        background: "#f7f9fb",
                        surface: "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e5",
                        "outline-variant": "#c5c6cd",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#45474c",
                        secondary: "#006a61",
                        error: "#ba1a1a"
                    },
                    fontFamily: {
                        sans: ["Inter"]
                    },
                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem"
                    }
                }
            }
        };
    </script>

    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .sidebar-item { transition: all 0.2s ease; }
        .sidebar-item:hover { background: #e6e8ea; }
        .sidebar-item.active { background: #091426; color: white; }
        .table-row { transition: background 0.15s ease; }
        .table-row:hover { background: #f7f9fb; }
    </style>
</head>
<body class="bg-background text-on-surface">

<div class="min-h-screen flex">

    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->
    <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">

        <!-- LOGO -->
        <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">school</span>
            </div>
            <div>
                <div class="font-bold text-primary text-lg">LinguistAI</div>
                <div class="text-xs text-on-surface-variant">Học viên</div>
            </div>
        </div>

        <!-- MENU -->
        <nav class="flex-1 px-3 py-5 space-y-1">
            <a asp-controller="HocVien" asp-action="Index"
               class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">dashboard</span>
                Tổng quan
            </a>

            <a asp-controller="HocVien" asp-action="LopCuaToi"
               class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
                <span class="material-symbols-outlined">groups</span>
                Lớp học của tôi
            </a>

            <a asp-controller="HocVien" asp-action="LichHoc"
   class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
    <span class="material-symbols-outlined">calendar_month</span>
    Lịch học
</a>

           
        </nav>

        <!-- USER -->
        <div class="border-t border-surface-variant p-4">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
                    @(hoTen.ToString().Substring(0, 1).ToUpper())
                </div>
                <div class="min-w-0">
                    <div class="font-medium text-sm truncate">@hoTen</div>
                    <div class="text-xs text-on-surface-variant">Học viên</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ================================================= -->
    <!-- MAIN -->
    <!-- ================================================= -->
    <main class="ml-[250px] flex-1 min-h-screen">

        <!-- TOPBAR -->
        <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8">
    <div>
        <h1 class="text-xl font-semibold text-primary">Lớp học của tôi</h1>
        <p class="text-sm text-on-surface-variant mt-1">
            Thông tin lớp học, lịch học, điểm danh và điểm số
        </p>
    </div>

    <div class="flex items-center gap-4">
        <a asp-controller="Account" asp-action="Logout"
           class="flex items-center gap-2 px-4 py-2 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
            <span class="material-symbols-outlined text-[20px]">logout</span>
            Đăng xuất
        </a>
    </div>
</header>

        <!-- NỘI DUNG -->
        <div class="p-8">
            @if (lopId == null)
            {
                <div class="bg-white rounded-xl p-10 text-center text-on-surface-variant">
                    Bạn chưa được xếp lớp. Vui lòng liên hệ trung tâm.
                </div>
            }
            else
            {
                <div id="cardLop" class="bg-white rounded-xl p-6 mb-6">Đang tải...</div>

                <div class="flex gap-2 mb-4">
                    <button onclick="chuyenTab('lich')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-primary text-white" id="tabBtnLich">Lịch học</button>
                    <button onclick="chuyenTab('diemDanh')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-surface-container" id="tabBtnDiemDanh">Điểm danh</button>
                    <button onclick="chuyenTab('diemSo')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-surface-container" id="tabBtnDiemSo">Điểm số</button>
                </div>

                <div id="tabLich" class="bg-white rounded-xl p-6"></div>
                <div id="tabDiemDanh" class="bg-white rounded-xl p-6 hidden"></div>
                <div id="tabDiemSo" class="bg-white rounded-xl p-6 hidden"></div>
            }
        </div>
    </main>

</div>

<script>
    const lopId = @Html.Raw(lopId ?? "null");

    function chuyenTab(ten) {
        ["lich", "diemDanh", "diemSo"].forEach(t => {
            const tenHoa = t.charAt(0).toUpperCase() + t.slice(1);
            document.getElementById("tab" + tenHoa).classList.toggle("hidden", t !== ten);
            document.getElementById("tabBtn" + tenHoa).className =
                "tab-btn px-4 py-2 rounded-lg text-sm font-medium " + (t === ten ? "bg-primary text-white" : "bg-surface-container");
        });
    }

   function mauTrangThaiDiemDanh(trangThai) {
    if (trangThai === "Có mặt") return "bg-green-50 text-green-700";
    if (trangThai === "Vắng") return "bg-red-50 text-red-700";
    if (trangThai === "Muộn") return "bg-amber-50 text-amber-700";
    return "bg-surface-container text-on-surface-variant";
}

function mauDiem(diem) {
    if (diem === null || diem === undefined) return "text-on-surface-variant";
    if (diem >= 8) return "text-green-700";
    if (diem >= 5) return "text-amber-700";
    return "text-error";
}

async function taiDuLieuLop() {
    if (!lopId) return;

    try {
        const res = await fetch(`/HocVien/ChiTietLop?id=${lopId}`);
        if (!res.ok) throw new Error("Lỗi tải dữ liệu");
        const data = await res.json();

        document.getElementById("cardLop").innerHTML = `
            <h2 class="text-lg font-bold text-primary mb-1">${data.lop.tenLop}</h2>
            <div class="text-sm text-on-surface-variant">
                ${data.lop.giaoVien || "--"} · ${data.lop.phongHoc || "--"} · ${data.lop.caHoc || "--"} · ${data.lop.trangThai || "--"}
            </div>
        `;

        document.getElementById("tabLich").innerHTML = `
            <h3 class="font-semibold text-primary mb-3">Lịch học</h3>
            <div class="text-sm mb-1">Ca học: ${data.lop.caHoc || "--"}</div>
            <div class="text-sm">Phòng học: ${data.lop.phongHoc || "--"}</div>
        `;

        // ===== TAB ĐIỂM DANH (có màu badge) =====
        const diemDanhHtml = (data.diemDanh && data.diemDanh.length > 0)
            ? `
                <div class="flex gap-4 mb-4 text-sm">
                    <div><span class="font-semibold text-green-700">${data.diemDanh.filter(d => d.trangThai === "Có mặt").length}</span> có mặt</div>
                    <div><span class="font-semibold text-red-700">${data.diemDanh.filter(d => d.trangThai === "Vắng").length}</span> vắng</div>
                    <div><span class="font-semibold text-amber-700">${data.diemDanh.filter(d => d.trangThai === "Muộn").length}</span> muộn</div>
                </div>
                ${data.diemDanh.map(d => `
                    <div class="flex items-center justify-between text-sm py-2.5 border-b border-surface-variant">
                        <span>${new Date(d.ngay).toLocaleDateString("vi-VN")}</span>
                        <div class="flex items-center gap-3">
                            ${d.ghiChu ? `<span class="text-on-surface-variant text-xs">${d.ghiChu}</span>` : ""}
                            <span class="px-2.5 py-1 rounded-full text-xs font-medium ${mauTrangThaiDiemDanh(d.trangThai)}">
                                ${d.trangThai}
                            </span>
                        </div>
                    </div>
                `).join("")}
            `
            : `<div class="text-sm text-on-surface-variant">Chưa có bản ghi điểm danh.</div>`;

        document.getElementById("tabDiemDanh").innerHTML = `
            <h3 class="font-semibold text-primary mb-3">Lịch sử điểm danh</h3>
            ${diemDanhHtml}
        `;

        // ===== TAB ĐIỂM SỐ (dạng ô card) =====
        const diemSoHtml = data.diemSo
            ? `
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
                    <div class="bg-surface-container-low rounded-lg p-4 text-center">
                        <div class="text-xs text-on-surface-variant mb-1">KT1</div>
                        <div class="text-xl font-bold ${mauDiem(data.diemSo.diemKT1)}">${data.diemSo.diemKT1 ?? "--"}</div>
                    </div>
                    <div class="bg-surface-container-low rounded-lg p-4 text-center">
                        <div class="text-xs text-on-surface-variant mb-1">KT2</div>
                        <div class="text-xl font-bold ${mauDiem(data.diemSo.diemKT2)}">${data.diemSo.diemKT2 ?? "--"}</div>
                    </div>
                    <div class="bg-surface-container-low rounded-lg p-4 text-center">
                        <div class="text-xs text-on-surface-variant mb-1">KT3</div>
                        <div class="text-xl font-bold ${mauDiem(data.diemSo.diemKT3)}">${data.diemSo.diemKT3 ?? "--"}</div>
                    </div>
                    <div class="bg-surface-container-low rounded-lg p-4 text-center">
                        <div class="text-xs text-on-surface-variant mb-1">Kiểm tra lớn</div>
                        <div class="text-xl font-bold ${mauDiem(data.diemSo.diemKiemTraLon)}">${data.diemSo.diemKiemTraLon ?? "--"}</div>
                    </div>
                </div>
                <div class="bg-primary rounded-xl p-5 flex items-center justify-between">
                    <div>
                        <div class="text-xs text-white/70 mb-1">Điểm trung bình</div>
                        <div class="text-2xl font-bold text-white">${data.diemSo.diemTrungBinh ?? "--"}</div>
                    </div>
                    <span class="px-3 py-1.5 rounded-full text-sm font-medium ${data.diemSo.ketQua === "Đạt" ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"}">
                        ${data.diemSo.ketQua ?? "--"}
                    </span>
                </div>
            `
            : `<div class="text-sm text-on-surface-variant">Chưa có điểm số.</div>`;

        document.getElementById("tabDiemSo").innerHTML = `
            <h3 class="font-semibold text-primary mb-3">Điểm số</h3>
            ${diemSoHtml}
        `;
    } catch (err) {
        document.getElementById("cardLop").innerHTML = `<div class="text-sm text-error">Không tải được dữ liệu.</div>`;
    }
}

    taiDuLieuLop();
    // ===================== CHATBOT =====================
function moChatbot() {
    document.getElementById("oChatbotPanel").classList.remove("hidden");
    document.getElementById("oChatbotToggle").classList.add("hidden");
    document.getElementById("oChatInput").focus();
}

function dongChatbot() {
    document.getElementById("oChatbotPanel").classList.add("hidden");
    document.getElementById("oChatbotToggle").classList.remove("hidden");
}

function themTinNhanChatbot(noiDung, nguoiGui) {
    const oChatMessages = document.getElementById("oChatMessages");
    const dong = document.createElement("div");

    if (nguoiGui === "nguoiDung") {
        dong.className = "flex items-start gap-2 justify-end";
        dong.innerHTML = `
            <div class="bg-primary text-white rounded-xl rounded-tr-none px-3 py-2 text-sm max-w-[80%]">
                ${noiDung}
            </div>`;
    } else {
        dong.className = "flex items-start gap-2";
        dong.innerHTML = `
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                ${noiDung}
            </div>`;
    }

    oChatMessages.appendChild(dong);
    oChatMessages.scrollTop = oChatMessages.scrollHeight;
}

async function guiTinNhanChatbot(e) {
    e.preventDefault();
    const oChatInput = document.getElementById("oChatInput");
    const noiDung = oChatInput.value.trim();
    if (!noiDung) return;

    themTinNhanChatbot(noiDung, "nguoiDung");
    oChatInput.value = "";

    try {
        themTinNhanChatbot("Đang xử lý...", "bot");
        const response = await fetch("/api/chatbot", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ message: noiDung })
        });
        const data = await response.json();
        const messages = document.getElementById("oChatMessages");
        if (messages.lastElementChild?.textContent.includes("Đang xử lý...")) messages.lastElementChild.remove();
        themTinNhanChatbot(response.ok ? (data.answer || "AI không trả về câu trả lời.") : (data.message || "Có lỗi xảy ra khi kết nối với chatbot."), "bot");
    } catch (error) {
        console.error("Lỗi chatbot:", error);
        themTinNhanChatbot("Không thể kết nối đến máy chủ chatbot.", "bot");
    }
}
</script>
<!-- CHATBOT NỔI -->
<div id="oChatbotPanel"
     class="hidden fixed bottom-24 right-6 z-50 w-[360px] max-w-[92vw] h-[480px] max-h-[75vh] bg-white rounded-xl border border-outline-variant shadow-2xl flex flex-col overflow-hidden">

    <div class="bg-primary text-white px-4 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
            </div>
            <div>
                <div class="text-sm font-semibold">Trợ lý AI</div>
                <div class="text-xs text-white/70">Luôn sẵn sàng hỗ trợ</div>
            </div>
        </div>
        <button onclick="dongChatbot()" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/10 transition">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div id="oChatMessages" class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 bg-surface">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                Xin chào! Tôi có thể giúp gì cho bạn hôm nay?
            </div>
        </div>
    </div>

    <form onsubmit="guiTinNhanChatbot(event)" class="border-t border-surface-variant p-3 flex items-center gap-2 shrink-0 bg-white">
        <input id="oChatInput" type="text" autocomplete="off" placeholder="Nhập câu hỏi của bạn..."
               class="flex-1 rounded-lg border border-outline-variant px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
        <button type="submit" class="w-10 h-10 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center hover:opacity-90 transition">
            <span class="material-symbols-outlined text-[20px]">send</span>
        </button>
    </form>
</div>

<button id="oChatbotToggle" onclick="moChatbot()"
        class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[26px]">smart_toy</span>
</button>
<script src="~/js/chatbot-history.js" asp-append-version="true"></script>
</body>
</html>