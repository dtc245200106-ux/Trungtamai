@model Trungtamai.Models.LopHoc

@{
    Layout = null;
    var hoTen = ViewBag.HoTen?.ToString() ?? "Học viên";

    // Tính tuần hiện tại (Thứ 2 → Chủ nhật)
    var homNay = DateTime.Today;
    int soNgayTuThuHai = homNay.DayOfWeek == DayOfWeek.Sunday
        ? 6
        : (int)homNay.DayOfWeek - 1;
    var ngayThuHai = homNay.AddDays(-soNgayTuThuHai);

    var cacThu = new[]
    {
        new { Ma = "T2", Ten = "Thứ 2", Ngay = ngayThuHai },
        new { Ma = "T3", Ten = "Thứ 3", Ngay = ngayThuHai.AddDays(1) },
        new { Ma = "T4", Ten = "Thứ 4", Ngay = ngayThuHai.AddDays(2) },
        new { Ma = "T5", Ten = "Thứ 5", Ngay = ngayThuHai.AddDays(3) },
        new { Ma = "T6", Ten = "Thứ 6", Ngay = ngayThuHai.AddDays(4) },
        new { Ma = "T7", Ten = "Thứ 7", Ngay = ngayThuHai.AddDays(5) },
        new { Ma = "CN", Ten = "Chủ nhật", Ngay = ngayThuHai.AddDays(6) }
    };

    // Các thứ học của lớp (ví dụ: "T2,T4,T6")
    var thuHocCuaLop = new HashSet<string>(
        (Model?.NgayHoc ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
        StringComparer.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch học - LinguistAI</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#091426",
                        "primary-container": "#1e293b",
                        "on-primary": "#ffffff",
                        background: "#f7f9fb",
                        surface: "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e0e3e5",
                        "outline-variant": "#c5c6cd",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#45474c",
                        secondary: "#006a61",
                        error: "#ba1a1a"
                    },
                    fontFamily: { sans: ["Inter"] },
                    borderRadius: { lg: "0.5rem", xl: "0.75rem" }
                }
            }
        };
    </script>

    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; }
        .sidebar-item { transition: all 0.2s ease; }
        .sidebar-item:hover { background: #e6e8ea; }
        .sidebar-item.active { background: #091426; color: white; }
        .schedule-card { transition: all 0.15s ease; }
        .schedule-card:hover { transform: translateY(-1px); box-shadow: 0 6px 14px rgba(0,0,0,0.08); }
    </style>
</head>
<body class="bg-background text-on-surface">

<div class="min-h-screen flex">

    <!-- SIDEBAR -->
    <aside class="w-[250px] bg-white border-r border-outline-variant fixed left-0 top-0 bottom-0 flex flex-col">
        <div class="h-[80px] flex items-center px-6 border-b border-surface-variant">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center mr-3">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">school</span>
            </div>
            <div>
                <div class="font-bold text-primary text-lg">LinguistAI</div>
                <div class="text-xs text-on-surface-variant">Học viên</div>
            </div>
        </div>

        <nav class="flex-1 px-3 py-5 space-y-1">
            <a asp-controller="HocVien" asp-action="Index"
               class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">dashboard</span>
                Tổng quan
            </a>

            <a asp-controller="HocVien" asp-action="LopCuaToi"
               class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined">groups</span>
                Lớp học của tôi
            </a>

            <a asp-controller="HocVien" asp-action="LichHoc"
               class="sidebar-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium">
                <span class="material-symbols-outlined">calendar_month</span>
                Lịch học
            </a>

           
        </nav>

        <div class="border-t border-surface-variant p-4">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
                    @(hoTen.Length > 0 ? hoTen.Substring(0, 1).ToUpper() : "H")
                </div>
                <div class="min-w-0">
                    <div class="font-medium text-sm truncate">@hoTen</div>
                    <div class="text-xs text-on-surface-variant">Học viên</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="ml-[250px] flex-1 min-h-screen">

        <header class="h-[80px] bg-white border-b border-outline-variant flex items-center justify-between px-8">
            <div>
                <h1 class="text-xl font-semibold text-primary">Lịch học</h1>
                <p class="text-sm text-on-surface-variant mt-1">
                    Lịch học tuần này của bạn
                </p>
            </div>

            <div class="flex items-center gap-4">
                <a asp-controller="Account" asp-action="Logout"
                   class="flex items-center gap-2 px-4 py-2 rounded-lg border border-outline-variant text-sm font-medium text-on-surface-variant hover:bg-surface-container transition">
                    <span class="material-symbols-outlined text-[20px]">logout</span>
                    Đăng xuất
                </a>
            </div>
        </header>

        <div class="p-8">

            @if (Model == null)
            {
                <div class="bg-white rounded-xl p-10 text-center text-on-surface-variant">
                    Bạn chưa được xếp lớp. Vui lòng liên hệ trung tâm để xem lịch học.
                </div>
            }
            else
            {
                <!-- Thông tin lớp -->
                <div class="bg-white rounded-xl border border-outline-variant p-5 mb-6">
                    <div class="flex flex-wrap items-center gap-4">
                        <div>
                            <div class="text-xs text-on-surface-variant mb-1">Lớp đang học</div>
                            <div class="text-lg font-semibold text-primary">@Model.TenLop</div>
                        </div>
                        <div class="h-8 w-px bg-surface-variant hidden sm:block"></div>
                        <div>
                            <div class="text-xs text-on-surface-variant mb-1">Giáo viên</div>
                            <div class="text-sm font-medium">@(string.IsNullOrWhiteSpace(Model.GiaoVien) ? "--" : Model.GiaoVien)</div>
                        </div>
                        <div class="h-8 w-px bg-surface-variant hidden sm:block"></div>
                        <div>
                            <div class="text-xs text-on-surface-variant mb-1">Ca học</div>
                            <div class="text-sm font-medium">@(string.IsNullOrWhiteSpace(Model.CaHoc) ? $"{Model.NgayHoc}, {Model.GioBatDau}-{Model.GioKetThuc}" : Model.CaHoc)</div>
                        </div>
                        <div class="h-8 w-px bg-surface-variant hidden sm:block"></div>
                        <div>
                            <div class="text-xs text-on-surface-variant mb-1">Phòng</div>
                            <div class="text-sm font-medium">@(string.IsNullOrWhiteSpace(Model.PhongHoc) ? "--" : Model.PhongHoc)</div>
                        </div>
                    </div>
                </div>

                <!-- Lưới lịch tuần -->
                <div class="bg-white rounded-xl border border-outline-variant overflow-hidden">
                    <div class="px-5 py-4 border-b border-surface-variant flex items-center justify-between">
                        <div class="font-semibold text-primary">Tuần này</div>
                        <div class="text-sm text-on-surface-variant">
                            @ngayThuHai.ToString("dd/MM") – @ngayThuHai.AddDays(6).ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 divide-y sm:divide-y-0 sm:divide-x divide-surface-variant">
                        @foreach (var thu in cacThu)
                        {
                            var coLich = thuHocCuaLop.Contains(thu.Ma);
                            var laHomNay = thu.Ngay.Date == DateTime.Today;

                            <div class="p-4 min-h-[140px] @(laHomNay ? "bg-primary/5" : "")">
                                <div class="flex items-center justify-between mb-3">
                                    <div>
                                        <div class="text-sm font-semibold @(laHomNay ? "text-primary" : "text-on-surface")">
                                            @thu.Ten
                                        </div>
                                        <div class="text-xs text-on-surface-variant">
                                            @thu.Ngay.ToString("dd/MM")
                                        </div>
                                    </div>
                                    @if (laHomNay)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-primary text-white">Hôm nay</span>
                                    }
                                </div>

                                @if (coLich)
                                {
                                    <div class="schedule-card rounded-lg bg-surface-container-low border border-outline-variant p-3">
                                        <div class="text-sm font-semibold text-primary mb-1">@Model.TenLop</div>
                                        <div class="text-xs text-on-surface-variant flex items-center gap-1 mb-1">
                                            <span class="material-symbols-outlined text-[14px]">schedule</span>
                                            @Model.GioBatDau – @Model.GioKetThuc
                                        </div>
                                        <div class="text-xs text-on-surface-variant flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">meeting_room</span>
                                            @(string.IsNullOrWhiteSpace(Model.PhongHoc) ? "Chưa có phòng" : Model.PhongHoc)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(Model.GiaoVien))
                                        {
                                            <div class="text-xs text-on-surface-variant flex items-center gap-1 mt-1">
                                                <span class="material-symbols-outlined text-[14px]">person</span>
                                                @Model.GiaoVien
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-xs text-on-surface-variant/70 italic pt-2">Không có lịch</div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Ghi chú -->
                <div class="mt-4 text-sm text-on-surface-variant">
                    Lịch được lấy theo lịch cố định của lớp (<strong>@Model.NgayHoc</strong>).
                    Nếu có thay đổi đột xuất, trung tâm sẽ thông báo.
                </div>
            }
        </div>
    </main>
</div>
<!-- CHATBOT NỔI -->
<div id="oChatbotPanel"
     class="hidden fixed bottom-24 right-6 z-50 w-[360px] max-w-[92vw] h-[480px] max-h-[75vh] bg-white rounded-xl border border-outline-variant shadow-2xl flex flex-col overflow-hidden">

    <div class="bg-primary text-white px-4 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
            </div>
            <div>
                <div class="text-sm font-semibold">Trợ lý AI</div>
                <div class="text-xs text-white/70">Luôn sẵn sàng hỗ trợ</div>
            </div>
        </div>
        <button onclick="dongChatbot()" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/10 transition">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div id="oChatMessages" class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 bg-surface">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                Xin chào! Tôi có thể giúp gì cho bạn hôm nay?
            </div>
        </div>
    </div>

    <form onsubmit="guiTinNhanChatbot(event)" class="border-t border-surface-variant p-3 flex items-center gap-2 shrink-0 bg-white">
        <input id="oChatInput" type="text" autocomplete="off" placeholder="Nhập câu hỏi của bạn..."
               class="flex-1 rounded-lg border border-outline-variant px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
        <button type="submit" class="w-10 h-10 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center hover:opacity-90 transition">
            <span class="material-symbols-outlined text-[20px]">send</span>
        </button>
    </form>
</div>

<button id="oChatbotToggle" onclick="moChatbot()"
        class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-primary text-white shadow-xl flex items-center justify-center hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[26px]">smart_toy</span>
</button>

<script>
// ===================== CHATBOT =====================
function moChatbot() {
    document.getElementById("oChatbotPanel").classList.remove("hidden");
    document.getElementById("oChatbotToggle").classList.add("hidden");
    document.getElementById("oChatInput").focus();
}

function dongChatbot() {
    document.getElementById("oChatbotPanel").classList.add("hidden");
    document.getElementById("oChatbotToggle").classList.remove("hidden");
}

function themTinNhanChatbot(noiDung, nguoiGui) {
    const oChatMessages = document.getElementById("oChatMessages");
    const dong = document.createElement("div");

    if (nguoiGui === "nguoiDung") {
        dong.className = "flex items-start gap-2 justify-end";
        dong.innerHTML = `
            <div class="bg-primary text-white rounded-xl rounded-tr-none px-3 py-2 text-sm max-w-[80%]">
                ${noiDung}
            </div>`;
    } else {
        dong.className = "flex items-start gap-2";
        dong.innerHTML = `
            <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="bg-white border border-outline-variant rounded-xl rounded-tl-none px-3 py-2 text-sm max-w-[80%]">
                ${noiDung}
            </div>`;
    }

    oChatMessages.appendChild(dong);
    oChatMessages.scrollTop = oChatMessages.scrollHeight;
}

async function guiTinNhanChatbot(e) {
    e.preventDefault();
    const oChatInput = document.getElementById("oChatInput");
    const noiDung = oChatInput.value.trim();
    if (!noiDung) return;

    themTinNhanChatbot(noiDung, "nguoiDung");
    oChatInput.value = "";

    try {
        themTinNhanChatbot("Đang xử lý...", "bot");

        const response = await fetch("/api/chatbot", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ message: noiDung })
        });
        const data = await response.json();
        const messages = document.getElementById("oChatMessages");
        const tinNhanCuoi = messages.lastElementChild;

        if (tinNhanCuoi && tinNhanCuoi.textContent.includes("Đang xử lý...")) {
            tinNhanCuoi.remove();
        }

        themTinNhanChatbot(
            response.ok ? (data.answer || "AI không trả về câu trả lời.") : (data.message || "Có lỗi xảy ra khi kết nối với chatbot."),
            "bot"
        );
    } catch (error) {
        console.error("Lỗi chatbot:", error);
        themTinNhanChatbot("Không thể kết nối đến máy chủ chatbot.", "bot");
    }
}
</script>


<script src="~/js/chatbot-history.js" asp-append-version="true"></script>
</body>
</html>